{
  "name": "@synapsedesk/grpc-proto",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node ../../scripts/copy-protos.mjs dist/proto",
    "proto:generate": "buf generate",
    "proto:lint": "buf lint",
    "proto:breaking": "buf breaking --against '../../.git#branch=main,subdir=libs/grpc-proto'",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ts-proto": "^2.12.0"
  },
  "dependencies": {
    "@nestjs/microservices": "^11.1.28",
    "@synapsedesk/common": "*"
  }
}
