# ingestion-service — every variable it reads, in the shared section order.
# Copy to `.env` and fill in real values; names and placeholders only here.

# ---------------------------------------------------------------- 1 RUNTIME

NODE_ENV = development

# The gRPC server the gateway calls.
GRPC_HOST = 0.0.0.0
GRPC_PORT = 5004

# ---------------------------------------------------------------- 2 BUILD
# Injected by the image build (Dockerfile ARGs) — a container has no `.git`
# to ask at runtime. Local runs use stand-in values; missing values refuse to
# boot rather than report "unknown".

APP_VERSION = 0.0.0-local
BUILD_SHA = 0000000000000000000000000000000000000000
BUILD_TIME = 1970-01-01T00:00:00.000Z

# ---------------------------------------------------------------- 3 DATA

# Domain C's OWN database — a different physical Postgres from auth's and
# ticket's. The separation is why `created_by_id` and `department_id` carry no
# foreign key.
DATABASE_URL = postgresql://user:password@localhost:5434/synapsedesk_ingestion?schema=public

# BullMQ's ingestion queue and the AI quota counter.
REDIS_URL = redis://localhost:6379
# A distinct db index per environment, so a suite's flush cannot take a
# developer's dev data with it. Optional; defaults to 0.
# REDIS_DB = 0

# The vector store — not optional for a service whose purpose is producing
# vectors; a worker without it refuses to boot rather than failing on the
# first document.
QDRANT_URL = http://localhost:6333

# ---------------------------------------------------------------- 4 MESSAGING

# Publishes document.* events.
NATS_URL = nats://localhost:4222
# The NATS server's HTTP monitor, for JetStream health checks.
NATS_MONITOR_URL = http://localhost:8222

# ---------------------------------------------------------------- 5 PEERS

# auth-service, for write-time validation of created_by_id / department_id and
# for reading the tenant's storage quota before signing an upload. Required:
# those columns carry no foreign key, so a service that cannot reach auth
# cannot safely create a document.
AUTH_SERVICE_URL = localhost:5001

# storage-service, for presigned document uploads. Required: without it
# `POST /documents/presign` has nothing to sign with, and an endpoint that
# 500s over a missing URL is worse than a boot refusal.
STORAGE_SERVICE_URL = localhost:50253

# ---------------------------------------------------------------- 7 THIRD PARTY

# Gemini, for embeddings. Obtain from Google AI Studio. Required outside
# NODE_ENV=test (tests run a substitute embedding client, so suites need no
# key, no network and no per-run spend).
GEMINI_API_KEY = your-gemini-api-key

# ---------------------------------------------------------------- 8 POLICY

# How long a download URL is ADVERTISED as valid, in seconds. MUST stay
# strictly below storage-service's READ_URL_TTL_SECONDS (900): that service
# owns the URL's real lifetime and this is only what the client is told, so a
# client refreshing on expiry does it just BEFORE the URL dies. Getting it
# backwards reads as a permissions bug — a 403 on a URL the client was told
# was still good.
DOWNLOAD_URL_TTL_SECONDS = 840
