{
  "name": "@synapsedesk/ingestion-service",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "start:prod": "node dist/src/main.js",
    "dev": "nest start --watch",
    "db:generate": "prisma generate && node ../../scripts/trim-erd.mjs ../../docs/reference/erd/ingestion-service.md",
    "db:apply": "node dist/src/database-check.js && prisma migrate deploy && node dist/src/schema-apply.js",
    "db:apply:test": "dotenv -e .env.test -- npm run db:apply",
    "db:migrate": "node ../../scripts/new-migration.mjs",
    "projection:backfill": "nest start --entryFile projection-backfill",
    "db:studio": "prisma studio",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "//@langchain/core": "A required PEER of @langchain/textsplitters, declared here even though NOTHING in src/ imports it — so a dependency-pruning pass reads it as unused and removing it is a one-line change that looks free. It is not: `text_splitter.cjs` requires `@langchain/core/documents` at LOAD time, so the service builds cleanly and then dies at boot with MODULE_NOT_FOUND, and its whole test suite fails to collect. It was missing from the lockfile for exactly that reason before anyone noticed.",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@langchain/core": "^1.3.0",
    "@langchain/textsplitters": "^1.0.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/microservices": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@qdrant/js-client-rest": "~1.19.0",
    "@synapsedesk/contracts": "*",
    "@synapsedesk/core": "*",
    "@synapsedesk/grpc-proto": "*",
    "@synapsedesk/nest-common": "*",
    "bullmq": "^6.5.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "joi": "^18.3.0",
    "js-tiktoken": "^1.0.21",
    "mammoth": "^1.13.0",
    "nats": "^2.29.3",
    "pdfjs-dist": "^6.4.299",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@synapsedesk/testing": "*",
    "@types/jest": "^30.0.0",
    "@types/turndown": "^5.0.6",
    "jest": "~30.4.2",
    "jest-mock-extended": "^4.0.2",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
