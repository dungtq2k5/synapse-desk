<?xml version="1.0" encoding="UTF-8" ?>
<!--
  The Java gateway's build.

  Not an npm workspace's build: `package.json` beside this file exists only so
  turbo can see the directory (the rag-service precedent), and declares no
  `build`, `lint` or `test`. Maven owns all three, and `npm test` must stay
  runnable without a JDK.

  This module reads files from OUTSIDE itself on purpose — the OpenAPI
  document, the protos, the GraphQL schema, the shared constants — because
  they are the same files the Node gateway is built from. That is also why it
  is `private`-equivalent: never deployed to a Maven repository, only into an
  image.
-->
<project
  xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
>
  <modelVersion>4.0.0</modelVersion>

  <!--
    **Stated, never inherited.** The Boot version is declared here and read
    from nowhere else, so nothing a tool scaffolds can move it.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath />
  </parent>

  <groupId>com.synapsedesk</groupId>
  <artifactId>api-gateway</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>api-gateway</name>
  <description
  >The Java implementation of the SynapseDesk API gateway</description>

  <licenses>
    <license>
      <name>AGPL-3.0-only</name>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <java.version>21</java.version>

    <!--
      gRPC and protobuf, pinned together: `protoc-gen-grpc-java` is released per grpc version, and the
      stubs it writes are compiled against `grpc-stub` of that version.
    -->
    <grpc.version>1.78.0</grpc.version>
    <protobuf.version>4.33.0</protobuf.version>

    <!-- The plugin below and the contract suite's agent, one version. -->
    <jacoco.version>0.8.15</jacoco.version>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!--
      The document this gateway PRODUCES, from the annotated controllers and
      their DTO classes. No `-ui`:
      this gateway has no browsable page to serve, only `/v3/api-docs` for
      `openapi:check` and, later, a real front end to read. Version read from
      `springdoc-openapi-starter-webmvc-api`'s own `maven-metadata.xml`
      (3.1.1) — the first line to track Spring Boot 4 / Spring Framework 7.
    -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <version>3.1.1</version>
    </dependency>
    <!--
      Schema-first: `docs/reference/schema.gql` is the tracked contract,
      copied into `target/classes/schema/` by the resources execution below
      and loaded from there — never regenerated. Node generates its own copy
      from decorators, which its e2e suite holds equal to this one.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-graphql</artifactId>
    </dependency>
    <!--
      `GraphqlPermissionAspect`: Spring for GraphQL dispatches a
      resolver outside the MVC handler chain, so `PermissionInterceptor`
      (a `HandlerInterceptor`) never sees it. AOP is the standard Spring
      answer to "run before a bean method, wherever it's called from" — the
      same mechanism `@PreAuthorize` uses on `@QueryMapping` methods.

      `spring-boot-starter-aop` does not exist past Spring Boot 4.0.0-M2 —
      dropped, not merely renamed like GraphQL's. `spring-aop` itself is
      already on the classpath (a `spring-context` transitive), and
      `AopAutoConfiguration` still ships in `spring-boot-autoconfigure`; the
      one thing genuinely missing is `aspectjweaver`, which Spring's
      annotation-style `@Aspect`/`@Around` parsing needs for its pointcut
      expressions even though no AspectJ weaving happens — proxy-based AOP,
      confirmed present via `javap` before pinning this.
    -->
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      The scrape endpoint. `micrometer-registry-prometheus` rather than
      `client_java` because J5 measured that Micrometer can be made to emit
      Node's exact series names, labels and buckets — `MetricsSeriesContractTest`
      is what holds them equal.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!--
      Redis: the response cache, the throttler counters, the tenant status
      and presence. Lettuce, Boot's default.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!--
      The first NATS consumer. `io.nats:jnats` directly rather than Spring's
      messaging abstraction — the same reasoning as the gRPC stubs being
      blocking: one concurrency model, and a jnats `Dispatcher`'s
      subscribe/close lifecycle is explicit rather than inferred through a
      framework layer. No dependency here before this consumer; `Subjects
      .java` was only constants.
    -->
    <dependency>
      <groupId>io.nats</groupId>
      <artifactId>jnats</artifactId>
      <version>2.26.3</version>
    </dependency>

    <!--
      Realtime. A pre-flight spike measured netty-socketio 2.0.14 against the
      repo's own `socket.io-client` 4.8.3 and passed, with three settings
      pinned — see `RealtimeServerConfig`. The NATS-sourced consumers relay
      LOCAL-ONLY (every replica already gets every event over NATS, no queue
      group, the same "each replica relays its own sockets" rule the
      cache-invalidation consumer already follows) — `RealtimeRelay` never
      touches netty-socketio's own store for that path.
    -->
    <dependency>
      <groupId>com.corundumstudio.socketio</groupId>
      <artifactId>netty-socketio</artifactId>
      <version>2.0.14</version>
    </dependency>

    <!--
      Presence and typing are the opposite of the relay above: they start on
      whichever replica a socket happens to be connected to and must reach
      every OTHER replica's sockets too — the genuinely cross-replica half
      `RealtimeRelay`'s docblock always said would need this. netty-socketio
      is not on Maven Central with Redisson bundled (checked the resolved
      dependency tree — it pulls nothing under `org.redisson`), so this is
      declared explicitly rather than inherited. `RealtimeServerConfig`
      wires a `RedissonStoreFactory` from it, pointed at the same Redis the
      cache and throttler already use.
    -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson</artifactId>
      <version>4.7.0</version>
    </dependency>

    <!--
      The five gRPC peers. Blocking stubs only: the gateway's calls are
      request/response inside one HTTP request, and a reactive stub would add
      a second concurrency model to a process that already has one.
    -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <!--
      RS256 verification only — the gateway never mints. Nimbus rather than
      hand-rolled RSA/PEM parsing: signature verification is a trust-boundary
      security path (see the repo's own no-simplify list), and this is a
      single well-audited jar, not a framework.
    -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>10.10</version>
    </dependency>
    <!--
      `@ValidPhoneNumber`: Node's `@IsPhoneNumber()` is libphonenumber-js, which is
      generated from this library's metadata, so this is the one that agrees with it.
      Version read from repo1 `maven-metadata.xml`.
    -->
    <dependency>
      <groupId>com.googlecode.libphonenumber</groupId>
      <artifactId>libphonenumber</artifactId>
      <version>9.0.40</version>
    </dependency>
    <!-- `@Generated` on the generated stubs; provided, not shipped. -->
    <dependency>
      <groupId>org.apache.tomcat</groupId>
      <artifactId>annotations-api</artifactId>
      <version>6.0.53</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        An unchecked conversion or a raw type fails the build, in main, test and
        generated code. JDK 21's `-Werror` takes no category, so any warning javac
        prints by default fails it too; there are none.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs combine.children="append">
            <arg>-Xlint:unchecked,rawtypes</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!--
        **Stated, not left to the default.** One fork, no parallel classes —
        already true with no config at all, since neither plugin below set
        `forkCount` before this. Left implicit, a later "speed the build up"
        can raise it on a machine where IDE JVMs (SonarLint, the language
        server) are already contending with Maven for memory — the exact
        contention that produced a killed build (exit 137) earlier in this
        module's history. Stating `1` is what stops that edit from looking
        free.
      -->
      <!--
        Coverage for SonarCloud. `prepare-agent` sets `argLine`, which surefire and
        failsafe both run with, so unit rows and ITs append to one
        `target/jacoco.exec`; `report` writes `target/site/jacoco/jacoco.xml` at
        `verify`, after the ITs.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!--
            The contract suite's coverage, run by name only (`phase` none):
            `./mvnw jacoco:merge@contract-merge jacoco:report@contract-report`
            after a run with `CONTRACT_JACOCO_AGENT` set. One `.exec` per gateway
            launch, merged, then reported against this build's classes.
          -->
          <execution>
            <id>contract-merge</id>
            <phase>none</phase>
            <goals>
              <goal>merge</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory
                  >${project.build.directory}/contract-jacoco</directory>
                  <includes>
                    <include>*.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile
              >${project.build.directory}/contract-jacoco.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>contract-report</id>
            <phase>none</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile
              >${project.build.directory}/contract-jacoco.exec</dataFile>
              <outputDirectory
              >${project.build.directory}/site/jacoco-contract</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        The JaCoCo agent the contract harness launches the gateway with, run by
        name only: `./mvnw dependency:copy@contract-agent` writes
        `target/jacoco-agent/jacocoagent.jar`.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>contract-agent</id>
            <phase>none</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.jacoco</groupId>
                  <artifactId>org.jacoco.agent</artifactId>
                  <version>${jacoco.version}</version>
                  <classifier>runtime</classifier>
                  <destFileName>jacocoagent.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory
              >${project.build.directory}/jacoco-agent</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>1</forkCount>
        </configuration>
      </plugin>

      <!--
        **`*IT` needs a real Redis; `*Test` needs nothing.** The same split the
        services have between `npm test` and their e2e runs: these rows assert
        what Redis itself does (the cache's wire format, an outage), and a fake
        would be a reimplementation of Redis, which is the one thing it must
        not be. So
        those rows run under failsafe, in `verify`, and `./mvnw test` stays
        runnable on a machine with nothing started.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <forkCount>1</forkCount>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        `protoc` and `protoc-gen-grpc-java` are downloaded per PLATFORM, and
        this is what names the platform. Without it the artifact classifier is
        unset and the build fails with a missing dependency rather than with
        anything about protobuf.
      -->
      <!--
        The GraphQL schema, COPIED rather than duplicated: Spring for GraphQL
        loads it from the classpath, and `docs/reference/schema.gql` is the
        published contract. Copied at build time so a change there cannot be
        half-applied — there is no second file to forget.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>graphql-schema</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory
              >${project.build.outputDirectory}/schema</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../../docs/reference</directory>
                  <includes>
                    <include>schema.gql</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
        <executions>
          <execution>
            <phase>initialize</phase>
            <goals>
              <goal>detect</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        The five peers' stubs, from the SAME `.proto` files every other
        service is generated from — `packages/grpc-proto/src/proto`, read from
        outside this module on purpose. A copy inside would be a second
        contract, and the first symptom of its drifting is a field that
        silently arrives empty.
      -->
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protoSourceRoot
          >${project.basedir}/../../packages/grpc-proto/src/proto</protoSourceRoot>
          <protocArtifact
          >com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact
          >io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>compile-custom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>
</project>
