{
  "name": "@synapsedesk/ticket-service",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nest build",
    "start:prod": "node dist/src/main.js",
    "dev": "nest start --watch",
    "db:generate": "prisma generate",
    "db:apply": "node dist/src/database-check.js && prisma migrate deploy && node dist/src/schema-apply.js",
    "db:apply:test": "dotenv -e .env.test -- npm run db:apply",
    "db:migrate": "node ../../scripts/new-migration.mjs",
    "db:studio": "prisma studio",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@synapsedesk/contracts": "*",
    "@synapsedesk/core": "*",
    "@synapsedesk/grpc-proto": "*",
    "@synapsedesk/nest-common": "*",
    "bullmq": "^5.81.3",
    "dotenv": "^17.4.2",
    "joi": "^18.2.3",
    "nats": "^2.29.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@synapsedesk/testing": "*",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^7.9.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
