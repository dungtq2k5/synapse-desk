# ticket-service — every variable it reads, in the shared section order.
# Copy to `.env` and fill in real values; names and placeholders only here.

# ---------------------------------------------------------------- 1 RUNTIME

NODE_ENV = development

# The gRPC server the gateway calls. 5002, since auth-service holds 5001.
GRPC_HOST = 0.0.0.0
GRPC_PORT = 5002

# ---------------------------------------------------------------- 2 BUILD
# Injected by the image build (Dockerfile ARGs) — a container has no `.git`
# to ask at runtime. Local runs use stand-in values; missing values refuse to
# boot rather than report "unknown".

APP_VERSION = 0.0.0-local
BUILD_SHA = 0000000000000000000000000000000000000000
BUILD_TIME = 1970-01-01T00:00:00.000Z

# ---------------------------------------------------------------- 3 DATA

# Domain B's OWN database — a different physical Postgres from auth-service's.
# That separation is the whole reason cross-service ids carry no foreign key.
DATABASE_URL = postgresql://user:password@localhost:5433/synapsedesk_ticket?schema=public

# The analytics export queue — ticket-service's first queue.
REDIS_URL = redis://localhost:6379
# A distinct db index per environment, so a suite's flush cannot take a
# developer's dev data with it. Optional; defaults to 0.
# REDIS_DB = 0

# ---------------------------------------------------------------- 4 MESSAGING

# Both directions: this service publishes ticket.* AND consumes audit.record.
NATS_URL = nats://localhost:4222
# The NATS server's HTTP monitor, for JetStream health checks (ADR 0041).
NATS_MONITOR_URL = http://localhost:8222

# ---------------------------------------------------------------- 5 PEERS

# auth-service, for write-time validation of author_id / assignee_id /
# department_id. There is no foreign key to do this.
AUTH_SERVICE_URL = localhost:5001

# storage-service, for message attachments.
STORAGE_SERVICE_URL = localhost:50253

# rag-service (Domain C, Python), for the AI RPCs. Required outside
# NODE_ENV=test; in test it may be absent, and every AI RPC then answers
# UNAVAILABLE — the honest state the AI suites assert.
RAG_SERVICE_URL = localhost:50255

# ---------------------------------------------------------------- 8 POLICY

# How long a sender may edit their own message.
MESSAGE_EDIT_WINDOW_MINUTES = 15
