{
  "name": "@synapsedesk/auth-service",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nest build",
    "start:prod": "node dist/src/main.js",
    "dev": "nest start --watch",
    "db:generate": "prisma generate && node ../../scripts/trim-erd.mjs ../../docs/reference/erd/auth-service.md",
    "db:apply": "node dist/src/database-check.js && prisma migrate deploy && node dist/src/schema-apply.js",
    "db:apply:test": "dotenv -e .env.test -- npm run db:apply",
    "db:migrate": "node ../../scripts/new-migration.mjs",
    "db:studio": "prisma studio",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@synapsedesk/contracts": "*",
    "@synapsedesk/core": "*",
    "@synapsedesk/grpc-proto": "*",
    "@synapsedesk/nest-common": "*",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.5.0",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "~14.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.3.0",
    "nats": "^2.29.3",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "~22.4.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@synapsedesk/testing": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "jest": "~30.4.2",
    "jest-mock-extended": "^4.0.2",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
