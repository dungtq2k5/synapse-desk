# rag-service — every variable it reads, in the shared section order.
# Copy to `.env` and fill in real values; names and placeholders only here.
#
# The declaration site is `rag_service/config.py`, and required vs optional
# is visible there: `os.environ[...]` fails loudly, `.get(..., default)`
# carries its default beside it. The guard keeping this file honest is
# `tests/test_env_contract.py` — pytest, because this is the Python
# toolchain's file (the TypeScript env guard names rag-service as guarded
# there).

# ---------------------------------------------------------------- 1 RUNTIME

# The gRPC server ticket-service and the gateway call. Optional; the
# defaults are the documented answer.
# GRPC_HOST = 0.0.0.0
# GRPC_PORT = 50255

# ---------------------------------------------------------------- 3 DATA

# The vector store. Required — a missing URL that defaulted to localhost
# would connect to whatever happened to be there.
QDRANT_URL = http://localhost:6333

# READ-ONLY view over ingestion-service's chunk tables. Same physical
# Postgres as ingestion; this service never writes it.
INGESTION_DATABASE_URL = postgresql://postgres:password123456789@localhost:5434/synapsedesk_ingestion

# The AI quota counter, shared keyspace with ingestion-service.
REDIS_URL = redis://localhost:6379
# Optional; defaults to 0.
# REDIS_DB = 0

# ---------------------------------------------------------------- 5 PEERS

# ingestion-service, for document metadata on retrieval hits.
INGESTION_SERVICE_URL = localhost:5004

# ---------------------------------------------------------------- 7 THIRD PARTY

# Gemini, for embeddings and chat. Obtain from Google AI Studio. Optional
# ONLY because the test environment substitutes the embedding client —
# unset outside tests, retrieval answers fail at first use.
GEMINI_API_KEY = your-gemini-api-key

# Which provider serves each role: `gemini` (the default) or `ollama`.
# Generation switches with a restart. The embedding switch, from A to B:
# (1) `npm run ai:reembed -- --model B` with everything running;
# (2) stop rag-service and ingestion-service, allowing 120 s for a job in flight;
# (3) once both have exited and their gRPC ports are free, run it again;
# (4) set AI_EMBEDDING_PROVIDER to B here and in ingestion-service, and start
# both. Until a model's collection is complete, retrieval answers 503.
# GEMINI_API_KEY above is needed only while a role says `gemini`.
# AI_GENERATION_PROVIDER = gemini
# AI_EMBEDDING_PROVIDER = gemini

# The Ollama server, when a role says `ollama`: the `ollama` service of the
# root Compose file (`docker compose up -d ollama`). `npm run ai:check-local`
# says whether the configured models fit this machine.
# OLLAMA_BASE_URL = http://localhost:11434

# The context every Ollama call asks for. Ollama's own default is small and
# truncates a long prompt silently; 8192 covers the largest prompt the eval
# sends, with room.
# OLLAMA_NUM_CTX = 8192

# Every model call's deadline, in milliseconds. An embedding call has a total
# one; a generation stream an IDLE one, between frames (the first included),
# because a long answer legitimately takes minutes and a stream that stops
# sending is the fault. Measured 2026-11-12: Gemini embeds 32 chunks in about
# 2 s and sends its first frame within 1.7 s; Ollama on the CPU takes about
# 6 s for 32 chunks and up to about 140 s before the 7B's first token at
# num_ctx 8192. A call past its deadline fails the way an unavailable
# provider does.
# GEMINI_EMBED_TIMEOUT_MS = 30000
# GEMINI_IDLE_TIMEOUT_MS = 60000
# OLLAMA_EMBED_TIMEOUT_MS = 120000
# OLLAMA_IDLE_TIMEOUT_MS = 300000

# ---------------------------------------------------------------- 9 DEVELOPMENT

# KILL SWITCHES for the two prompt-injection defence layers — on by default,
# and a production checklist should find both still on. Read through
# `_flag()`, which accepts 1/true/yes/on (`bool()` of a string would read
# "false" as ON, the wrong direction for a security toggle).
# INJECTION_REGEX_ENABLED = true
# INJECTION_LLM_ENABLED = true

# Where this runs: `production` in a cluster (the generated config map sets
# it), `development` anywhere else. Read only to refuse RAG_OFFLINE_MODEL.
APP_ENV = development

# The model-free provider, for the end-to-end stack only: fixed embeddings and
# fixed answers that cite their sources, with no key and no network. Refused
# at boot under APP_ENV=production. The web end-to-end suite sets it itself.
# RAG_OFFLINE_MODEL = false
