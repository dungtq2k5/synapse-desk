# E2E-test environment for rag-service.
#
# Real Qdrant and real Postgres, per development-conventions §13.3 — and the
# database is the TEST one, for the same reason every other service points at a
# test database: these fixtures write and delete chunk rows.

QDRANT_URL = http://localhost:6333

# postgres_ingestion's TEST database. rag-service is READ-ONLY against it in
# production; the fixtures write directly because `tenant_scope()` is what is
# under test, not ingestion.
INGESTION_DATABASE_URL = postgresql://postgres:password123456789@localhost:5434/synapsedesk_ingestion_test

REDIS_URL = redis://localhost:6379
REDIS_DB = 5

# The gRPC server under test.
GRPC_HOST = 0.0.0.0
GRPC_PORT = 50255

# ingestion-service, which owns `ai_generations` — this service never writes
# that table directly. The retrieval suite substitutes the ledger client, so
# nothing has to be listening here.
INGESTION_SERVICE_URL = localhost:50254
