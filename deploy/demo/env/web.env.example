# The demo's web: derived from apps/web/.env.example, with the hosts the
# demo's Compose network names, the public address, and the mounted
# secrets. Copy to web.env (gitignored) and fill in the secrets.

# The gateway's in-cluster address, for server rendering only: the browser
# always calls the web's own origin.
GATEWAY_URL = http://api-gateway:3000

# Google sign-in (Firebase Authentication). Public values: read per request and
# handed to the browser, never built in. Unset FIREBASE_API_KEY and the
# "Continue with Google" button isn't shown. These are the Auth emulator's
# (compose's `firebase` service): its project is synapsedesk-test, and it
# takes any API key. In production, the Firebase project's web app config.
FIREBASE_API_KEY = emulator-api-key
FIREBASE_AUTH_DOMAIN = your-project.firebaseapp.com
FIREBASE_PROJECT_ID = synapsedesk-test
# The Auth emulator, development and tests only. Unset in production, where
# the SDK talks to Firebase.
# The Storage emulator, development and tests only: where a profile photo is
# uploaded to and shown from. Unset in production, where it's Firebase Storage.

# The support address, shown as a mail link wherever the app says "Contact
# support" (the frozen page, a negotiated plan). Read per request, like
# Firebase's config. A placeholder: the real address is yours to set.
SUPPORT_EMAIL = support@synapsedeskapp.com
