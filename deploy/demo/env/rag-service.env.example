# The demo's rag-service: derived from services/rag-service/.env.example, with the hosts the
# demo's Compose network names, the public address, and the mounted
# secrets. Copy to rag-service.env (gitignored) and fill in the secrets.

# rag-service — every variable it reads, in the shared section order.
# Copy to `.env` and fill in real values; names and placeholders only here.
#
# The declaration site is `rag_service/config.py`, and required vs optional
# is visible there: `os.environ[...]` fails loudly, `.get(..., default)`
# carries its default beside it. The guard keeping this file honest is
# `tests/test_env_contract.py` — pytest, because this is the Python
# toolchain's file (the TypeScript env guard names rag-service as guarded
# there).

# ---------------------------------------------------------------- 1 RUNTIME

# The gRPC server ticket-service and the gateway call. Optional; the
# defaults are the documented answer.
# GRPC_HOST = 0.0.0.0
# GRPC_PORT = 50255

# ---------------------------------------------------------------- 3 DATA

# The vector store. Required — a missing URL that defaulted to localhost
# would connect to whatever happened to be there.
QDRANT_URL = http://qdrant:6333

# READ-ONLY view over ingestion-service's chunk tables. Same physical
# Postgres as ingestion; this service never writes it.
INGESTION_DATABASE_URL = postgresql://postgres:password123456789@postgres-ingestion:5432/synapsedesk_ingestion

# The AI quota counter, shared keyspace with ingestion-service.
REDIS_URL = redis://redis:6379
# Optional; defaults to 0.
# REDIS_DB = 0

# ---------------------------------------------------------------- 5 PEERS

# ingestion-service, for document metadata on retrieval hits.
INGESTION_SERVICE_URL = ingestion-service:5004

# ---------------------------------------------------------------- 7 THIRD PARTY

# Gemini, for embeddings and chat. Obtain from Google AI Studio. Optional
# ONLY because the test environment substitutes the embedding client —
# unset outside tests, retrieval answers fail at first use.
GEMINI_API_KEY = your-gemini-api-key

# ---------------------------------------------------------------- 9 DEVELOPMENT

# KILL SWITCHES for the two prompt-injection defence layers — on by default,
# and a production checklist should find both still on. Read through
# `_flag()`, which accepts 1/true/yes/on (`bool()` of a string would read
# "false" as ON, the wrong direction for a security toggle).
# INJECTION_REGEX_ENABLED = true
# INJECTION_LLM_ENABLED = true

# Where this runs: `production` in a cluster (the generated config map sets
# it), `development` anywhere else. Read only to refuse RAG_OFFLINE_MODEL.
APP_ENV = development

# The model-free provider, for the end-to-end stack only: fixed embeddings and
# fixed answers that cite their sources, with no key and no network. Refused
# at boot under APP_ENV=production. The web end-to-end suite sets it itself.
# RAG_OFFLINE_MODEL = false


NODE_ENV = production
