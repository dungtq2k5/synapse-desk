# The demo's `tools` service: the seeds, run by hand on the demo's network
# (README.md). Copy to tools.env (gitignored) and fill in the passwords.

# The plan seed (`npm run plans:seed:apply`) writes to the auth database.
DATABASE_URL = postgresql://postgres:change-me@postgres-auth:5432/synapsedesk_auth?schema=public

# The plan seed reads each plan's price ids from Stripe (test mode), so it
# needs the demo's Stripe key: the same as env/auth-service.env.
STRIPE_SECRET_KEY = sk_test_...

# `seed:demo` reads these before any `.env` file.
AUTH_DATABASE_URL = postgresql://postgres:change-me@postgres-auth:5432/synapsedesk_auth?schema=public
TICKET_DATABASE_URL = postgresql://postgres:change-me@postgres-ticket:5432/synapsedesk_ticket?schema=public
INGESTION_DATABASE_URL = postgresql://postgres:change-me@postgres-ingestion:5432/synapsedesk_ingestion?schema=public

# The demo's databases count as local for the seeders, here only. `db:reset`
# never reads this, so nothing resets the demo.
SEED_DATABASE_HOSTS = postgres-auth,postgres-ticket,postgres-ingestion

# Every seeded user's password: at least 12 characters, a lowercase and an
# uppercase letter, a number and a symbol, and not the repository's.
SEED_DEMO_PASSWORD = change-me-to-a-strong-one

# auth-service's rounds, so the seeded hashes are as strong as a sign-up's.
BCRYPT_ROUNDS = 12
