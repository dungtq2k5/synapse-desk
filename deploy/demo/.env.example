# The demo project's own settings, read by `docker compose`. Copy to .env
# (gitignored).

# The clean worktree the images are built from, and its commit (README.md).
DEMO_SOURCE = /home/you/synapsedesk-demo
DEMO_SHA = 0000000
DEMO_BUILD_TIME = 2026-01-01T00:00:00Z

# The four Postgres containers' superuser. Every DATABASE_URL in env/ uses it.
DB_USER = postgres
DB_PASSWORD = change-me
