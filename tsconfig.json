{
  // jest.config.ts / jest.config.base.ts are deliberately absent: jest evaluates
  // them itself as ESM, which requires the explicit `.ts` import extension that
  // tsc rejects (TS5097) unless `allowImportingTsExtensions` is set — and that
  // flag demands noEmit, which would break `nest build`. They are tooling
  // config, not part of the compiled program.
  "include": [
    "apps/*/src/**/*",
    "apps/*/test/**/*",
    "apps/*/prisma.config.ts",
    "libs/*/src/**/*",
    // The demo seeder. In the root program because `tsx` does not typecheck —
    // a wrong enum member is `undefined` at runtime, which once wrote 200
    // documents with the column default and reported success. Left out, every
    // aggregate command in this repository was green over code none of them
    // read.
    "scripts/seed-demo/**/*",
    // The system harness, for the seeder's exact reason one entry up: ts-jest
    // transpiles per file and typechecks no program, so a green run says
    // nothing — and this directory landed outside the include three documents
    // after the seeder did. `typecheck-coverage.spec.ts` is what turns this
    // list from a series of patches into a rule.
    "test/system/**/*"
  ],
  // The two harness jest configs are the header's jest-config case again: they
  // import each other with the explicit `.ts` extension jest's ESM loading
  // requires and tsc rejects (TS5097). They stay typechecked — by
  // `test/system/tsconfig.json`, whose `noEmit` makes the permitting flag
  // legal there.
  "exclude": ["node_modules", "dist", "test/system/jest*.config.ts"],
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    // Emits `.d.ts.map` beside every `.d.ts`. A library clears `paths` (see
    // `libs/*/tsconfig.json`), so an editor resolving `@synapsedesk/common` from
    // INSIDE another library lands on `dist/main.d.ts` — compiled output with no
    // comments and no implementation. The map is what lets "go to definition"
    // follow through to `src/`, which is where the answer actually is.
    "declarationMap": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "rootDir": ".",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "types": ["node", "jest"],
    "paths": {
      "@synapsedesk/common": ["libs/common/src/main.ts"],
      "@synapsedesk/common/*": ["libs/common/src/*"],
      "@synapsedesk/grpc-proto": ["libs/grpc-proto/src/index.ts"],
      "@synapsedesk/grpc-proto/*": ["libs/grpc-proto/src/*"]
    }
  }
}
