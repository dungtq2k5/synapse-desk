<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Java gateway's build.

  Not an npm workspace's build: `package.json` beside this file exists only so
  turbo can see the directory (the rag-service precedent), and declares no
  `build`, `lint` or `test`. Maven owns all three, and `npm test` must stay
  runnable without a JDK.

  This module reads files from OUTSIDE itself on purpose — the OpenAPI
  document, the protos, the GraphQL schema, the shared constants — because
  they are the same files the Node gateway is built from. That is also why it
  is `private`-equivalent: never deployed to a Maven repository, only into an
  image.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    **Stated, never inherited.** The openapi-generator scaffold writes Boot
    4.0.1 of its own accord, so a pom that took the generator's word for the
    version would drift the moment the generator moved. Measured together on
    2026-09-20 (J4): interfaces generated by 7.25.0 with
    `useSpringBoot4=true` compile against this parent.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.synapsedesk</groupId>
  <artifactId>api-gateway-java</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>api-gateway-java</name>
  <description>The Java implementation of the SynapseDesk API gateway</description>

  <licenses>
    <license>
      <name>AGPL-3.0-only</name>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <!--
      **The pinned pair, in one block, because they are one decision.**
      `useSpringBoot4` exists only from generator 7.x and targets Boot 4; the
      generator's default is still `useSpringBoot3`. Moving either version
      without the other is what J4 exists to prevent.
    -->
    <java.version>21</java.version>
    <openapi-generator.version>7.25.0</openapi-generator.version>

    <!--
      gRPC and protobuf, pinned together for the same reason as the pair
      above: `protoc-gen-grpc-java` is released per grpc version, and the
      stubs it writes are compiled against `grpc-stub` of that version.
    -->
    <grpc.version>1.78.0</grpc.version>
    <protobuf.version>4.33.0</protobuf.version>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      The scrape endpoint. `micrometer-registry-prometheus` rather than
      `client_java` because J5 measured that Micrometer can be made to emit
      Node's exact series names, labels and buckets — `MetricsSeriesContractTest`
      is what holds them equal.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!--
      Redis: the implementation lease, and later the response cache, the
      throttler counters and the socket adapter's channels. Lettuce (Boot's
      default) rather than Jedis — the lease's refresh runs on a timer and a
      blocking pool would hold a thread per beat.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!--
      The five gRPC peers. Blocking stubs only: the gateway's calls are
      request/response inside one HTTP request, and a reactive stub would add
      a second concurrency model to a process that already has one.
    -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <!--
      RS256 verification only — the gateway never mints. Nimbus rather than
      hand-rolled RSA/PEM parsing: signature verification is a trust-boundary
      security path (see the repo's own no-simplify list), and this is a
      single well-audited jar, not a framework.
    -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>10.10</version>
    </dependency>
    <!-- `@Generated` on the generated stubs; provided, not shipped. -->
    <dependency>
      <groupId>org.apache.tomcat</groupId>
      <artifactId>annotations-api</artifactId>
      <version>6.0.53</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        **Stated, not left to the default.** One fork, no parallel classes —
        already true with no config at all, since neither plugin below set
        `forkCount` before this. Left implicit, a later "speed the build up"
        can raise it on a machine where IDE JVMs (SonarLint, the language
        server) are already contending with Maven for memory — the exact
        contention that produced a killed build (exit 137) earlier in this
        module's history. Stating `1` is what stops that edit from looking
        free.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>1</forkCount>
        </configuration>
      </plugin>

      <!--
        **`*IT` needs a real Redis; `*Test` needs nothing.** The same split the
        Node side has between `npm test` and `npm run test:e2e:gateway`: the
        lease's claim is a Lua script, and a fake that "runs" it would be a
        reimplementation of Redis, which is the one thing it must not be. So
        those rows run under failsafe, in `verify`, and `./mvnw test` stays
        runnable on a machine with nothing started.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <forkCount>1</forkCount>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        The REST surface, generated from the document the Node gateway
        exports. Reading a file outside this module is the point: one
        document, two implementations, and `openapi:check` already proves it
        matches the Node source while `openapiViolations` proves it is a valid
        OpenAPI document — the second half was added after this generator
        refused the file.
      -->
      <!--
        `protoc` and `protoc-gen-grpc-java` are downloaded per PLATFORM, and
        this is what names the platform. Without it the artifact classifier is
        unset and the build fails with a missing dependency rather than with
        anything about protobuf.
      -->
      <!--
        The GraphQL schema, COPIED rather than duplicated: Spring for GraphQL
        loads it from the classpath, and `apps/api-gateway/src/schema.gql` is
        the one both implementations serve. Copied at build time so a change
        there cannot be half-applied — there is no second file to forget.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>graphql-schema</id>
            <phase>generate-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/schema</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../api-gateway/src</directory>
                  <includes><include>schema.gql</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
        <executions>
          <execution>
            <phase>initialize</phase>
            <goals><goal>detect</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!--
        The five peers' stubs, from the SAME `.proto` files every other
        service is generated from — `libs/grpc-proto/src/proto`, read from
        outside this module on purpose. A copy inside would be a second
        contract, and the first symptom of its drifting is a field that
        silently arrives empty.
      -->
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protoSourceRoot>${project.basedir}/../../libs/grpc-proto/src/proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>compile-custom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>rest-interfaces</id>
            <phase>generate-sources</phase>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/../../docs/reference/openapi.json</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>com.synapsedesk.gateway.generated.api</apiPackage>
              <modelPackage>com.synapsedesk.gateway.generated.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateSupportingFiles>false</generateSupportingFiles>

              <configOptions>
                <!--
                  **`skipDefaultInterface` is the whole compile-time
                  guarantee** (J3, measured). Left at its default the
                  generator emits `default` methods returning 501: a
                  controller missing a method COMPILES, and the route answers
                  501 at runtime instead of failing the build.
                -->
                <skipDefaultInterface>true</skipDefaultInterface>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot4>true</useSpringBoot4>
                <useBeanValidation>true</useBeanValidation>
                <useTags>true</useTags>
                <openApiNullable>false</openApiNullable>
                <!--
                  **No swagger annotations, and no springdoc.** This gateway
                  does not PUBLISH an OpenAPI document — it is generated FROM
                  the one the Node gateway exports, and a second document
                  derived from the first is a second thing to drift. Without
                  this the generated code imports
                  `io.swagger.v3.oas.annotations`, which is not a dependency
                  here.
                  Measured: both belong INSIDE `configOptions`. As direct
                  plugin parameters — siblings of `configOptions`, where the
                  plugin's own documentation suggests them — they are
                  silently ignored and the imports come back.
                -->
                <documentationProvider>none</documentationProvider>
                <annotationLibrary>none</annotationLibrary>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>
</project>
