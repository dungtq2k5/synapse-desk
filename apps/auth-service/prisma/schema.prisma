// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../../docs/reference/erd/auth-service.md"
  theme    = "default"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. ORGANIZATIONS (Tenant Boundary)
// ==========================================
model Organization {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String  @db.VarChar(255)
  // FULL `@unique`, not the partial `WHERE deleted_at IS NULL` index every
  // other soft-deletable name in this file uses — and the difference is
  // RESTORE. `restoreOrganization` un-deletes a tenant in place and keeps its
  // slug, so these two must stay reserved while it is offboarded: a partial
  // index would let a new tenant claim `acme` in the meantime and leave the
  // restore to fail, or to produce two live tenants answering the same URL.
  //
  // `subscription_plans.name` goes the other way for the same reason read
  // backwards — a retired plan is never restored, so reuse is wanted there and
  // its index is partial.
  slug   String  @unique @db.VarChar(100)
  domain String? @unique @db.VarChar(255)

  // Tenant state & governance
  status              String   @db.VarChar(50)
  enforceTwoFactor    Boolean  @default(false) @map("enforce_two_factor")
  allowedEmailDomains String[] @map("allowed_email_domains") @db.VarChar(255)

  /// The tenant's inbound-mail address token.
  ///
  /// The support address is `support+{inbound_token}@<domain>`, delivered by
  /// one catch-all route. NOT the slug: a slug is guessable, which makes every
  /// tenant's inbound address derivable from any other and the tenant list
  /// enumerable. This is not a secret — customers email it — but it is
  /// unguessable and rotatable, which a slug is neither.
  ///
  /// **NULLABLE, so email is opt-in per tenant.** A tenant with no token
  /// receives no mail, which is the right default for a feature nobody enabled
  /// — and it makes "unroutable" a state the lookup returns rather than one it
  /// has to infer.
  ///
  /// **32 hex characters, not `generateSecureToken()`**. That
  /// helper is `base64url`, which is 43 characters (too long for this column)
  /// and CASE-SENSITIVE. Mail systems normalize local-part case in practice, so
  /// one hop lowercasing the address would silently unroute the tenant, and
  /// nothing here could tell that apart from nobody having written in.
  inboundToken String? @unique @map("inbound_token") @db.VarChar(32)

  // Quotas & metering
  //
  // **No `@default()` on any of them, deliberately.** A NOT NULL column with no
  // default is required in Prisma's create type, so every organization create
  // has to answer "what does this tenant get" at COMPILE time rather than
  // inheriting a number from a file its author never opened. The answer is
  // `FREE_TIER_ENTITLEMENTS`, which is also what the Free plan row is seeded
  // from — one definition, not two.
  //
  // Four of these defaults were literal copies of platform constants, and had
  // the staleness hazard the plan grants document: raise the constant and every
  // new tenant stays at the old number, with no error anywhere.
  maxAgentSeats        Int    @map("max_agent_seats")
  maxStorageBytes      BigInt @map("max_storage_bytes")
  monthlyAiTokenBudget BigInt @map("monthly_ai_token_budget")

  /// The largest document this tenant's PLAN admits, copied here like every
  /// other entitlement.
  ///
  /// Denormalized onto the tenant for the reason `maxAgentSeats` is: the
  /// enforcement paths read ONE row, and a join to `subscription_plans` on
  /// every presign would put the catalogue in the hot path of the highest
  /// volume route in the system.
  ///
  /// Distinct from `max_document_bytes_override` below: this is what the plan
  /// GRANTS, that is what the tenant chose to NARROW to. Readers take the
  /// `min()` of both and the platform ceiling, so neither can widen the other.
  maxDocumentBytes BigInt @map("max_document_bytes")

  /// The largest attachment this tenant's PLAN admits — denormalized for the
  /// same reason as `maxDocumentBytes` above.
  ///
  /// **The ceiling above it is a TRANSPORT bound, not a policy one.**
  /// `MAX_ATTACHMENT_BYTES` is 10 MB because the gRPC message limit binds
  /// there, with `MAX_AI_ATTACHMENT_BYTES` at 8 MB beneath it. A plan has very
  /// little room to differentiate on this column, which is worth knowing before
  /// it reaches a pricing page.
  maxAttachmentBytes BigInt @map("max_attachment_bytes")

  /// The most documents this tenant's PLAN admits.
  ///
  /// Denormalized like the grants above, and bounded by
  /// `MAX_DOCUMENTS_PER_TENANT` at every enforcement point.
  ///
  /// Counting a tenant's documents is `ingestion-service`'s job; this column is
  /// only the LIMIT. The two meet at the gateway, never inside auth.
  maxDocumentUploads Int @map("max_document_uploads")

  /// How far back this tenant's PLAN lets analytics look, in days.
  ///
  /// **The one grant the admission rule does not cover.** Every other limit is
  /// checked
  /// when something is CREATED, so lowering it can only refuse the next thing.
  /// A lookback window has no creation event: it restricts a read over data that
  /// already exists, so narrowing it takes away history the tenant could see
  /// yesterday. That is accepted deliberately rather than grandfathered — a
  /// per-subscriber window would make a plan's stated grant not be what its
  /// subscribers have, which is the property the catalogue is built on.
  ///
  /// Read by BOTH analytics surfaces — `ai-analytics.service.ts` in ingestion
  /// and `analytics.service.ts` in ticket. A window honoured by one and not the
  /// other is worse than no window, because the answer depends on which page
  /// the tenant opened.
  maxAnalyticsRangeDays Int @map("max_analytics_range_days")

  /// Follows Stripe's `current_period_start` once billing is live.
  ///
  /// **Load-bearing beyond its own column:** its epoch is inside the Redis
  /// quota key, so anything that writes this implicitly re-arms every quota
  /// threshold alert and zeroes the counter. That is exactly right at a genuine
  /// renewal and a silent budget grant if it fires by accident — which is why
  /// `POST /platform/organizations/:id/billing-cycle/reset` is now break-glass.
  billingCycleStart DateTime @default(now()) @map("billing_cycle_start") @db.Timestamptz

  /// `FAST | QUALITY` — the sellable AI entitlement.
  ///
  /// Defaults to FAST, and the default is what makes the migration safe: every
  /// existing row gets a usable tier without a backfill, and a NULL reaching
  /// the settings layer would be an unresolvable model name at request time.
  aiModelTier String @default("FAST") @map("ai_model_tier") @db.VarChar(20)

  /// The catalogue plan this workspace is on.
  ///
  /// **NULL means "no plan; the entitlement columns are authoritative"** —
  /// which is every tenant today and stays true for any tenant that never
  /// subscribes. There is no backfill: a workspace acquires a plan by
  /// subscribing or by direct assignment, and until then behaves exactly as it
  /// does now. Same state `stripe.service.ts` names when the API key is absent,
  /// where "every tenant stays grandfathered".
  planId String?           @map("plan_id") @db.Uuid
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id])

  /// Whether a Stripe webhook may rewrite this workspace's entitlements.
  ///
  /// **Set when a Super Admin grants something off-catalogue.** Without it the
  /// writer re-derives all five columns from the price on the next routine
  /// event — a renewal, a card update — and a negotiated seat count silently
  /// reverts. The monotonic guard cannot help: it compares Stripe's `created`
  /// timestamps and a manual edit has none.
  ///
  /// A FLAG rather than a parallel set of override columns, so "this tenant is
  /// off-catalogue" is a state one query can list rather than something
  /// inferred by diffing columns against a plan. The event is still recorded
  /// and still ordered; only the write is skipped, as `SKIPPED_PINNED`.
  entitlementsPinned Boolean @default(false) @map("entitlements_pinned")

  // Tenant-imposed ceilings — NARROWING only
  //
  /// The largest document this tenant will accept, at or below the platform
  /// ceiling.
  ///
  /// **A safety control, not a billing one.** An organization that knows its
  /// staff should never upload a 100 MB file sets 5 MB, and a mis-click or a
  /// compromised account cannot burn its storage grant. Every layer narrows and
  /// no layer widens: a value above `MAX_DOCUMENT_BYTES` would be a
  /// self-service entitlement grant, so the edge refuses it rather than
  /// clamping.
  ///
  /// **NULL means the tenant has configured nothing**, and that is the normal
  /// state. The entitlement columns above are NOT NULL with defaults because a
  /// subscription always grants a value; these are the opposite, and a default
  /// would make "chose the platform maximum" indistinguishable from "chose
  /// nothing" — which is exactly the distinction the plan layer needs so it can
  /// rewrite a grant without clobbering a tenant's own setting.
  maxDocumentBytesOverride BigInt? @map("max_document_bytes_override")

  /// The largest ATTACHMENT this tenant will accept. See
  /// `maxDocumentBytesOverride`; the same rule and the same NULL meaning.
  maxAttachmentBytesOverride BigInt? @map("max_attachment_bytes_override")

  /// How many attachments one message may carry, at or below the platform
  /// ceiling. See `maxDocumentBytesOverride`.
  maxAttachmentsPerMessageOverride Int? @map("max_attachments_per_message_override")

  /// The tenant's business timezone.
  ///
  /// Distinct from `users.timezone`, which is a person's quiet hours. This one
  /// answers "when does this tenant's Monday start", and every daily analytics
  /// figure is bucketed by it: a tenant at UTC+7 whose Monday begins at 17:00
  /// Sunday UTC would otherwise see every daily number split across two rows
  /// with no way for a consumer to reassemble them.
  ///
  /// An IANA name. NULL is treated as UTC — wrong for the tenant and at least
  /// deterministic, where the server's zone would be wrong in a way that
  /// changes when the service is redeployed.
  timezone String? @db.VarChar(64)

  // -------------------------------------------------------------------------
  // Stripe — exactly TWO columns, and no more (RDM §1.15).
  //
  // Plan names, price points and feature lists are deliberately NOT mirrored.
  // Copying them here creates a second source of truth that diverges the first
  // time someone edits a price in the Stripe dashboard — silently, because both
  // sides keep answering questions confidently.
  //
  // **Both are nullable, and the nullability IS the migration path.** A tenant
  // with NULL on both is a perfectly valid free/internal/grandfathered account
  // whose entitlements were set by hand and are never overwritten, because no
  // webhook will ever name them. Backfilling placeholder customers to make
  // these non-null would break exactly that.
  // -------------------------------------------------------------------------

  stripeCustomerId     String? @unique @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String? @unique @map("stripe_subscription_id") @db.VarChar(255)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  deletedById String?   @map("deleted_by_id") @db.Uuid

  // Relations
  deletedBy     User?            @relation("OrganizationDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  departments   Department[]
  users         User[]           @relation("UserOrganization")
  roles         Role[]           @relation("RoleOrganization")
  invitations   UserInvitation[]
  billingEvents BillingEvent[]

  @@map("organizations")
}

// ==========================================
// 2. DEPARTMENTS (Functional Sub-Units)
// ==========================================
model Department {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  description    String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedById    String?   @map("deleted_by_id") @db.Uuid

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id])
  deletedBy       User?            @relation("DepartmentDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  userDepartments UserDepartment[]

  @@map("departments")
}

// ==========================================
// 3. USERS (Central Identity)
// ==========================================
model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // NULL organizationId identifies a SaaS platform Super Admin operating across
  // tenants. Kept in lockstep with isSuperAdmin by a DB CHECK constraint added
  // via migration: (organization_id IS NULL) = is_super_admin
  organizationId String? @map("organization_id") @db.Uuid
  isSuperAdmin   Boolean @default(false) @map("is_super_admin")

  /// Unique per TENANT, not globally (RDM §1.10). One person may hold accounts
  /// in several tenants — a contractor serving two clients, a re-hire, an
  /// inherited mailbox.
  ///
  /// Deliberately NOT `@@unique([organizationId, email])`: that compiles to a
  /// FULL unique index, which keeps soft-deleted rows enrolled and so re-breaks
  /// the re-hire case this change exists to fix. Postgres also does not treat
  /// NULLs as equal, so Super Admins (organization_id IS NULL) need a second
  /// guard. Both constraints are partial and therefore inexpressible here —
  /// `applyPartialIndexes()` in seed.ts creates them:
  ///   CREATE UNIQUE INDEX users_org_email_key
  ///     ON users (organization_id, email) WHERE deleted_at IS NULL;
  ///   CREATE UNIQUE INDEX users_super_admin_email_key
  ///     ON users (email) WHERE organization_id IS NULL AND deleted_at IS NULL;
  ///
  /// Same split as Role.name below.
  email              String    @db.VarChar(255)
  isEmailVerified    Boolean   @default(false) @map("is_email_verified")
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  fullName           String    @map("full_name") @db.VarChar(150)
  avatarUrl          String?   @map("avatar_url") @db.Text
  phoneNumber        String?   @map("phone_number") @db.VarChar(30)
  isPhoneVerified    Boolean   @default(false) @map("is_phone_verified")
  dob                DateTime? @db.Date
  gender             String?   @db.VarChar(20)
  isTwoFactorEnabled Boolean   @default(false) @map("is_two_factor_enabled")
  twoFactorSecret    String?   @map("two_factor_secret") @db.VarChar(255)

  /// **The one authoritative boolean.** Every read in the system asks this and
  /// only this — login, 2FA, forgot-password, both notification audiences, the
  /// last-Org-Admin count, list filters and the mappers.
  isLocked Boolean @default(false) @map("is_locked")

  /// When a temporary lock lapses. NULL means the lock is INDEFINITE — the
  /// existing behaviour, unchanged.
  ///
  /// **`is_locked` remains authoritative**, which is the entire design: this
  /// column answers only "when should it stop", so adding it touched three call
  /// sites rather than 22. The naive alternative —
  /// `isLocked || lockedUntil > now` at every read — is 22 chances to get a
  /// boolean wrong in code where wrong means either a locked user can log in or
  /// an unlocked user cannot.
  ///
  /// Two mechanisms act on it, and the redundancy is deliberate: a lazy unlock
  /// on the login path (instant, no job dependency) and an hourly sweep (which
  /// is what makes lists and notification audiences correct without any of them
  /// learning about time). Neither alone is enough — see `ExpiredLockSweep`.
  ///
  /// No index: the sweep scans `is_locked = true`, which is a tiny set.
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz

  /// Quiet hours — GLOBAL user settings, not per notification type.
  ///
  /// RDM Table 25 puts them here rather than on `notification_preferences`
  /// deliberately: "do not disturb me between 22:00 and 07:00" is a fact about
  /// the person, and per-type quiet hours would be a setting nobody could
  /// reason about. notification-service reads them on the same gRPC call that
  /// already resolves recipients.
  ///
  /// Stored as "HH:mm" strings rather than as `time` columns: they are compared
  /// against a wall clock in `timezone`, never against a database timestamp,
  /// and a `time` column invites exactly the mistake of comparing it to
  /// `NOW()` in the SERVER's zone.
  ///
  /// A window may CROSS MIDNIGHT (22:00-07:00), which is the common case and
  /// the one a naive `start < now < end` gets wrong — for precisely the users
  /// who set quiet hours at all.
  quietHoursStart String? @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd   String? @map("quiet_hours_end") @db.VarChar(5)

  /// An IANA name — "Asia/Ho_Chi_Minh". NULL is treated as UTC, which is wrong
  /// for the user and at least deterministic; the alternative, the server's
  /// zone, is wrong in a way that changes when the service is redeployed.
  timezone    String?   @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  deletedById String?   @map("deleted_by_id") @db.Uuid

  // Relations
  organization Organization? @relation("UserOrganization", fields: [organizationId], references: [id])
  deletedBy    User?         @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  // Junction Relations
  userDepartments         UserDepartment[] @relation("UserDepartments")
  assignedUserDepartments UserDepartment[] @relation("UserDepartmentAssignedBy")

  // Audit and self-referential relations
  deletedUsers         User[]             @relation("UserDeletedBy")
  deletedOrganizations Organization[]     @relation("OrganizationDeletedBy")
  deletedPlans         SubscriptionPlan[] @relation("SubscriptionPlanDeletedBy")
  deletedDepartments   Department[]       @relation("DepartmentDeletedBy")
  createdRoles         Role[]             @relation("RoleCreatedBy")

  // Child Session & Security Relations
  deviceSessions       DeviceSession[]
  twoFactorBackupCodes TwoFactorBackupCode[]
  otps                 Otp[]
  passwordResetTokens  PasswordResetToken[]

  // The `user_roles` junction (RDM Table 7). IMPLICIT on purpose.
  //
  // Where a junction carries no payload, letting Prisma own the join table is
  // the more robust option: the two foreign keys, their cascades and the pair
  // uniqueness are generated together and cannot drift apart, and there is no
  // hand-written model to keep in step with this relation. `user_departments`
  // next door is explicit for the opposite reason -- it carries `is_primary`,
  // which an implicit relation cannot hold.
  //
  // The cost is naming: the physical table is `_user_roles` with `A`/`B`
  // columns, so RAW SQL needs those while everything going through Prisma uses
  // the relation. RDM Table 7 specifies it explicitly as `user_roles(user_id,
  // role_id)` because that document is what people read the model FROM -- the
  // spec is always explicit, the schema is not, and neither is wrong.
  //
  // No payload here is itself deliberate: grant provenance lives in
  // `audit_logs` (`USER_ROLES_UPDATED`), because a join row records the
  // current state and an audit row records the act.
  roles Role[] @relation("user_roles")

  // Invitations this user sent, accepted and revoked
  invitationsSent    UserInvitation[] @relation("InvitationInvitedBy")
  invitationAccepted UserInvitation[] @relation("InvitationAcceptedUser")
  invitationsRevoked UserInvitation[] @relation("InvitationRevokedBy")

  // Plain lookup index, NOT a constraint. Login now loads every candidate row
  // for an address across tenants, so this is the index that read walks.
  @@index([email])
  @@map("users")
}

// ==========================================
// 4. USER DEPARTMENTS (Explicit Junction)
// ==========================================
model UserDepartment {
  userId       String   @map("user_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  isPrimary    Boolean  @default(false) @map("is_primary")
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  // Relations
  user       User       @relation("UserDepartments", fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignedBy User?      @relation("UserDepartmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, departmentId])
  @@map("user_departments")
}

// ==========================================
// 5. ROLES
// ==========================================
model Role {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  organizationId String? @map("organization_id") @db.Uuid

  name         String   @db.VarChar(100)
  description  String?  @db.Text
  isSystemRole Boolean  @default(false) @map("is_system_role")
  userAssigned Int      @default(0) @map("user_assigned")
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization? @relation("RoleOrganization", fields: [organizationId], references: [id])
  createdBy    User          @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // The `user_roles` and `role_permissions` junctions (RDM Tables 7-8),
  // implicit by design -- physically `_user_roles` and `_role_permissions`,
  // with `A`/`B` columns. See the note on `User.roles`.
  users       User[]       @relation("user_roles")
  permissions Permission[] @relation("role_permissions")

  // Two tenants may each define a role named "Tier 2 Lead".
  // Postgres does not treat NULLs as equal here, so global system roles are
  // additionally guarded by a partial unique index added via migration:
  //   CREATE UNIQUE INDEX roles_global_name_key ON roles (name) WHERE organization_id IS NULL;
  @@unique([organizationId, name])
  @@map("roles")
}

// ==========================================
// 6. PERMISSIONS
// ==========================================
model Permission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // The `role_permissions` junction (RDM Table 8), implicit by design and
  // physically `_role_permissions`. The row exists to be joined, not to be
  // authoritative:
  // the permission LIST is a compile-time artifact and this is what it points
  // at -- docs/decisions/0038-permissions-are-a-compile-time-artifact.md.
  roles Role[] @relation("role_permissions")

  @@map("permissions")
}

// ==========================================
// 7. DEVICE SESSIONS
// ==========================================
model DeviceSession {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // SHA-256 (hex) of the opaque refresh token, NOT bcrypt. bcrypt salts
  // randomly, so the same token hashes differently every time and could never
  // be found by this unique index -- you would have to scan every session and
  // compare one by one. SHA-256 is safe here precisely because the token is 32
  // random bytes: bcrypt's slowness exists to protect LOW-entropy human
  // passwords from guessing, which is not the threat model for a 256-bit secret.
  refreshTokenHash String @unique @map("refresh_token_hash") @db.VarChar(64)

  // Constant across refresh-token rotations. Presenting an already-rotated
  // token is evidence of theft, and the correct response is to revoke the whole
  // family rather than just the one row.
  familyId String @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid

  // Set when this token is exchanged for a successor. The row is KEPT rather
  // than deleted precisely so a later replay of the spent token is detectable:
  // if it were deleted, replay would look identical to an unknown token and the
  // theft would go unnoticed. Pruned by a scheduled job once expiresAt passes.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz

  // SHA-256 of the "remember this device" secret. Deliberately a SEPARATE
  // column from refreshTokenHash: the refresh token rotates on every use, while
  // device trust must survive those rotations for its full 30-day life.
  deviceTokenHash String? @unique @map("device_token_hash") @db.VarChar(64)

  // When trust lapses, independent of the session's own expiresAt.
  trustedUntil DateTime? @map("trusted_until") @db.Timestamptz

  deviceName String?  @map("device_name") @db.VarChar(100)
  ipAddress  String   @map("ip_address") @db.VarChar(45)
  userAgent  String   @map("user_agent") @db.Text
  isTrusted  Boolean  @default(false) @map("is_trusted")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("device_sessions")
}

// ==========================================
// 8. TWO-FACTOR BACKUP CODES
// ==========================================
model TwoFactorBackupCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.VarChar(255)
  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_backup_codes")
}

// ==========================================
// 9. OTPS (Email & Phone Verification Codes)
// ==========================================
model Otp {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // 'EMAIL_VERIFICATION' | 'PHONE_VERIFICATION'
  purpose String @db.VarChar(50)

  // The exact email address or phone number the code was dispatched to. Kept
  // separate from users.email/phone_number so a pending change can be verified
  // before it is written onto the user record.
  target   String @db.VarChar(255)
  codeHash String @map("code_hash") @db.VarChar(255)

  // Brute-force guard: the verify handler increments attemptsCount and flips
  // isUsed to true once attemptsCount reaches maxAttempts, burning the code.
  attemptsCount Int @default(0) @map("attempts_count")
  maxAttempts   Int @default(5) @map("max_attempts")

  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otps")
}

// ==========================================
// 10. PASSWORD RESET TOKENS
// ==========================================
model PasswordResetToken {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // SHA-256 (hex) of the emailed token, for the same reason as
  // DeviceSession.refreshTokenHash: a @unique column must be looked up BY VALUE,
  // which a randomly-salted bcrypt hash makes impossible. The raw token exists
  // only in the email; it is never stored.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  // Request provenance, surfaced in the reset email ("this request came from
  // Chrome on macOS, 203.0.113.7") and in audit_logs.
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ==========================================
// 11. USER INVITATIONS
// ==========================================
/// Tokenized offer of tenant membership (RDM Table 28).
///
/// A sibling of Otp and PasswordResetToken, but keyed to an organization +
/// address rather than a user_id — the recipient has no account yet, which is
/// the entire point. Invitations are how someone whose email domain does NOT
/// match the tenant gets in.
model UserInvitation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  email          String @db.VarChar(255)

  /// SHA-256 hex of a 32-byte URL-safe token. The raw value exists only in the
  /// emailed link — same by-value-lookup discipline as PasswordResetToken, and
  /// the same reason it is not bcrypt (see utils.hashToken).
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  /// A plain string, not a Prisma enum — same convention as
  /// `organizations.status`.
  ///
  /// The allowed values live in `InvitationStatus` in `@synapsedesk/common`,
  /// which is the single definition both services already share. A Postgres
  /// enum would be a SECOND source of truth that only auth-service can see, and
  /// adding a member to it requires a migration rather than an edit.
  status String @default("PENDING") @db.VarChar(50)

  /// PROPOSALS, not facts — deliberately arrays rather than FK relations.
  /// Validated at redemption, so a role or department deleted during the 7-day
  /// window is skipped and reported, never fatal. An FK would make the delete
  /// either impossible or silently destructive.
  roleIds             String[] @map("role_ids") @db.Uuid
  departmentIds       String[] @map("department_ids") @db.Uuid
  primaryDepartmentId String?  @map("primary_department_id") @db.Uuid

  invitedById String? @map("invited_by_id") @db.Uuid

  /// Groups one bulk import so a 200-row paste can be reported on as a unit.
  batchId String? @map("batch_id") @db.Uuid

  resentCount Int      @default(0) @map("resent_count")
  lastSentAt  DateTime @default(now()) @map("last_sent_at") @db.Timestamptz

  acceptedUserId String?   @map("accepted_user_id") @db.Uuid
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  revokedById    String?   @map("revoked_by_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz

  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedUser User?        @relation("InvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  revokedBy    User?        @relation("InvitationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  /// One OUTSTANDING invite per address per tenant. Partial (status = PENDING),
  /// so it cannot be @@unique — applied by applyPartialIndexes() in the seed,
  /// same as users.email:
  ///   CREATE UNIQUE INDEX user_invitations_pending_key
  ///     ON user_invitations (organization_id, email) WHERE status = 'PENDING';
  @@index([organizationId, status])
  @@index([expiresAt])
  @@index([batchId])
  @@map("user_invitations")
}

/// RDM Table 30 — every Stripe webhook the system ACCEPTED as genuine.
///
/// Exists for idempotency and ordering, not for reporting. Append-only and
/// never edited: the audit-field policy does not apply, because this is an
/// event log — the closest thing to it here is `audit_logs`, which is
/// append-only for the same reason.
///
/// **Signature verification happens BEFORE this table.** An event that fails
/// Stripe's check is rejected at the edge and never recorded, so a row here
/// means "we believed this and acted on it" — which is what makes the table
/// useful during an incident.
model BillingEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The id of the ACT this row records. **The unique constraint IS the
  /// idempotency mechanism**: a redelivered webhook is a duplicate-key
  /// violation the handler catches and acknowledges, not a second entitlement
  /// write. Delivery is at-least-once, so this is the normal path rather than a
  /// defensive one.
  ///
  /// **Two producers, and the column name names only the first.** Stripe's
  /// `evt_…` for an event we CONSUMED, and a derived `plan-change:{org}:{key}`
  /// for a change we are PRODUCING — the same mechanism from the other
  /// direction, which is what stops a double-submitted plan change reaching
  /// Stripe twice and being invoiced twice. Kept as one column rather than two
  /// tables because the question both answer is identical: *did we already act
  /// on this?*
  ///
  /// **The two differ in LIFETIME, and `source` is how to tell them apart.** A
  /// `STRIPE` row is permanent history. A `LOCAL` row is a lock held for one
  /// request and deleted when the attempt settles either way — kept, it became
  /// a plan change nobody could retry, because the constraint has no TTL and
  /// the no-header key is the plan tuple, which recurs.
  stripeEventId String @unique @map("stripe_event_id") @db.VarChar(255)

  /// Resolved from `stripe_customer_id`. NULLABLE because an event can arrive
  /// for a customer with no tenant yet — checkout can complete before
  /// onboarding does — and losing the event would be worse than storing it
  /// unattached.
  organizationId String? @map("organization_id") @db.Uuid

  eventType String @map("event_type") @db.VarChar(100)

  /// **Stripe's `created`, not ours** — the monotonic guard. An entitlement
  /// write is applied only when this is newer than the newest already applied
  /// for the subscription. Webhooks arrive out of order, and without this a
  /// delayed `subscription.updated` carrying the old plan lands after an
  /// upgrade and silently downgrades a paying tenant.
  stripeCreatedAt DateTime @map("stripe_created_at") @db.Timestamptz

  /// The raw event. Kept because entitlement-mapping bugs are only diagnosable
  /// against what Stripe actually sent, and a re-derivation needs the original.
  payload Json @db.JsonB

  /// BillingEventStatus. `SKIPPED_STALE` is the monotonic guard firing, and
  /// seeing it regularly is information rather than noise.
  status String @default("PROCESSED") @db.VarChar(20)

  /// BillingEventSource — who WROTE this row.
  ///
  /// **`STRIPE` rows order the tenant's timeline; `LOCAL` rows must not.** The
  /// monotonic guard takes the newest PROCESSED row as the high-water mark and
  /// compares Stripe's `created` (whole SECONDS) against it. A locally-produced
  /// claim carries `now()` to the millisecond, so without this filter a plan
  /// change's own claim makes the webhook it caused look stale — measured: the
  /// event settles `SKIPPED_STALE`, entitlements are never written, and the
  /// tenant is billed for a plan they do not hold.
  ///
  /// Defaulted to `STRIPE` because every row that existed before this column
  /// was one.
  source String @default("STRIPE") @db.VarChar(20)

  /// Why a FAILED event failed, for replay.
  errorLog String? @map("error_log") @db.Text

  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// The monotonic check reads the newest applied event per tenant on every
  /// webhook, so this index is on the hot path of the integration.
  @@index([organizationId, stripeCreatedAt(sort: Desc)])
  @@index([eventType])

  /// The FINANCE read, which neither index above covers. The composite is
  /// tenant-first and unusable for a cross-tenant range; `[eventType]` has no
  /// time component. A platform-wide `stripe_created_at BETWEEN ... GROUP BY
  /// event_type, day` walks the table without this.
  ///
  /// `source` leads because every finance query filters it to `STRIPE` — one
  /// equality then a range, served in a single seek. Leading with the timestamp
  /// would make the filter a post-scan predicate on rows already read.
  @@index([source, stripeCreatedAt])
  @@map("billing_events")
}

/// The HEARTBEAT.
///
/// **One row per job name, and the deepest fix in that document.** The jobs not
/// running was not the real problem; the real problem was that nothing anywhere
/// could tell you they were not running. A failed job at least logs. A job that
/// never runs logs nothing at all — which is precisely the case that occurred,
/// and it stayed invisible for two domains.
///
/// **Four copies of this table is CORRECT**, and this note
/// exists so nobody re-opens it. Service-per-database means each service
/// records its own jobs in its own failure domain: "did ingestion-service's
/// rollup run?" is a question about ingestion-service's database, and a shared
/// heartbeat service would report healthy while that database was unreachable —
/// the original bug, reintroduced with extra infrastructure. Four tables
/// holding different rows is not duplication of facts; no single fact is stored
/// twice.
///
/// The *behaviour* lives once, in `JobRunRecorder` (`libs/common`), over a
/// hand-written `JobRunStore` that each service binds to its own delegate.
/// `job-run-schema.spec.ts` asserts these four blocks stay identical — they
/// had already begun to drift in comments before it existed.
///
/// Not tenant-scoped: these jobs sweep across every tenant, so "did the rollup
/// run" is one question with one answer per service.
model JobRun {
  /// The job name from `SCHEDULED_JOBS`, or a step within one. The PK, so
  /// recording a run is a single upsert with no read first.
  jobName String @id @map("job_name")

  lastStartedAt   DateTime  @map("last_started_at")
  /// **Preserved across a failure**, deliberately. This is what the staleness
  /// alert reads, and clearing it on failure would turn "broken since Tuesday"
  /// into "never ran", losing the one piece of information worth having.
  ///
  /// Nullable because it is null until the FIRST success — which is how
  /// `checkStaleness` tells "never ran" from "stale".
  lastSucceededAt DateTime? @map("last_succeeded_at")

  lastDurationMs Int?    @map("last_duration_ms")
  /// Truncated by `JobRunRecorder` — a driver stack trace is kilobytes and the
  /// first line is what anybody reads.
  lastError      String? @map("last_error")

  /// Reset to 0 on success. A count that only ever grows is how a job failing
  /// every night for a month reads as one failure.
  consecutiveFailures Int @default(0) @map("consecutive_failures")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("job_runs")
}

/// A sellable plan: what it GRANTS, joined to Stripe by an opaque id.
///
/// **Keyed on Stripe PRODUCT, not price.** Stripe's model is one Product per
/// plan with multiple Prices only for billing variants — monthly versus annual,
/// or currencies — because Checkout and invoices render the PRODUCT name on
/// every line item, so tiers sharing a Product are indistinguishable on a
/// customer's receipt. Keying this table by price id would make "Pro monthly"
/// and "Pro annual" two rows carrying duplicated entitlements that drift.
///
/// **What a plan COSTS is Stripe's and is deliberately absent here.** Mirroring
/// an amount is the two-sources-of-truth problem `billing.config.ts` was
/// written to prevent, and the divergence is silent because both sides keep
/// answering confidently.
model SubscriptionPlan {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Uniqueness will be handled by code because `deletedAt`
  name String @db.VarChar(100)

  /// NULL for a plan ASSIGNED rather than sold — the negotiated agreement,
  /// invisible to self-service and legal on purpose.
  stripeProductId String? @unique @map("stripe_product_id") @db.VarChar(255)

  maxAgentSeats        Int    @map("max_agent_seats")
  maxStorageBytes      BigInt @map("max_storage_bytes")
  monthlyAiTokenBudget BigInt @map("monthly_ai_token_budget")

  /// `FAST | QUALITY`. A string, not a Prisma enum —
  /// `development-conventions.md` §7.3, ADR 0001.
  aiModelTier String @map("ai_model_tier") @db.VarChar(20)

  /// The largest document this plan admits.
  ///
  /// **NOT NULL like every other grant: a plan states every limit it grants,
  /// with no blanks.** A plan that does not differentiate on file size states
  /// the platform ceiling explicitly, which is a decision recorded rather than
  /// inferred — and it keeps a CRUD form six required fields rather than four
  /// plus two whose emptiness carries meaning.
  ///
  /// **A plan can only NARROW.** `MAX_DOCUMENT_BYTES` protects the parser
  /// (known-gaps #15, #17) and is not sellable, so this is an argument to
  /// `min()` and never a replacement for it — selling a larger file than the
  /// platform admits is not expressible, which is correct.
  ///
  /// **The cost of NOT NULL is paid at apply time.** A row holding today's
  /// ceiling goes stale when the constant moves. Downward is harmless — `min()`
  /// keeps the smaller number — but UPWARD is silent: raising
  /// `MAX_DOCUMENT_BYTES` leaves every tenant gated at whatever their plan row
  /// says, top tier included, with no error anywhere. A change to the constant
  /// is a catalogue edit plus an apply, not a code change on its own.
  ///
  /// 100 MB of headroom makes a 5/25/100 MB ladder a visible one.
  maxDocumentBytes BigInt @map("max_document_bytes")

  /// The largest attachment this plan admits — the same NOT NULL rule, the same
  /// narrow-only composition, and the same staleness cost as `maxDocumentBytes`
  /// above.
  ///
  /// **Almost no room to differentiate, and it is worth knowing before pricing
  /// on it.** `MAX_ATTACHMENT_BYTES` is 10 MB because the gRPC message limit
  /// binds there, with `MAX_AI_ATTACHMENT_BYTES` at 8 MB beneath it — so no
  /// plan can offer more than 10 MB, and creating headroom means moving a
  /// transport limit rather than a policy one. A 2/5/10 MB ladder is
  /// expressible; it is just a narrow one.
  maxAttachmentBytes BigInt @map("max_attachment_bytes")

  /// The most documents this plan admits, NOT NULL like every other grant.
  ///
  /// Bounded by `MAX_DOCUMENTS_PER_TENANT`, which is the first cap on the
  /// CORPUS rather than on any single upload: `maxStorageBytes` bounds the
  /// bytes, and this bounds the vector points behind retrieval.
  maxDocumentUploads Int @map("max_document_uploads")

  /// How far back this plan lets analytics look, in days.
  ///
  /// **The only grant whose narrowing is retroactive**, so it is the only one a
  /// plan edit can take something away with. `applyPlan` reports no over-limit
  /// subset for it — there is none, because lowering it affects every
  /// subscriber equally and at once — which is why `PLAN_LIMIT_DIMENSIONS` does
  /// not list it.
  maxAnalyticsRangeDays Int @map("max_analytics_range_days")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  /// WHO retired the plan, on a `Restrict` relation like every other
  /// soft-deletable table in this service.
  ///
  /// Retiring a plan is a catalogue decision with a blast radius, and the Super
  /// Admin who made it stays resolvable for as long as the row does rather than
  /// the decision going anonymous. `Restrict` is what enforces that: the
  /// deleter's own user row cannot be hard-deleted out from under it.
  deletedById String? @map("deleted_by_id") @db.Uuid

  deletedBy     User?                   @relation("SubscriptionPlanDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  prices        SubscriptionPlanPrice[]
  organizations Organization[]

  @@map("subscription_plans")
}

/// One Stripe Price, and the plan it grants.
model SubscriptionPlanPrice {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId String @map("plan_id") @db.Uuid

  /// The lookup the webhook performs. UNIQUE because one price belongs to
  /// exactly one plan — and because the uniqueness is what makes an unmapped
  /// price a `FAILED` event rather than an ambiguous one.
  stripePriceId String @unique @map("stripe_price_id") @db.VarChar(255)

  /// `month` | `year`. Display and ordering only — NEVER an entitlement input.
  ///
  /// **Lowercase because it is STRIPE's literal, stored as it arrives**, and
  /// `development-conventions.md` §7.3's *"values are SCREAMING_SNAKE_CASE,
  /// with no exceptions"* is about values this repo DEFINES. Upper-casing a
  /// foreign literal breaks the comparison the moment anything matches it
  /// against a webhook payload — and Stripe's vocabulary is wider than these
  /// two, so this is not an enum of ours waiting to be written.
  interval String @db.VarChar(20)

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("subscription_plan_prices")
}

/// How many times a tenant's limit alarm has RE-ARMED, per dimension.
///
/// **Durable because it defeats a durable guard.** The alert's
/// `notifications.event_id` is derived, so a re-crossing after a recovery would
/// republish an id Domain E's permanent `UNIQUE (recipient_id, event_id)`
/// already holds — and be rejected as a duplicate the tenant never sees. The
/// generation makes each occurrence a new event.
///
/// It cannot live in Redis beside the alarm LEVEL: a flush would reset it to
/// zero, the next crossing would republish a held id, and that dimension would
/// stop alerting for that tenant permanently, from a transient failure. A
/// counter that steps past a permanent guard must outlive it.
///
/// The level stays in Redis on purpose — losing it costs at most one duplicate
/// alert, which the durable guard then collapses.
model LimitAlertGeneration {
  organizationId String @map("organization_id") @db.Uuid

  /// `seats` | `storage` | `documents` — `LimitAlertDimension` in
  /// `@synapsedesk/common`, stored VERBATIM in that union's own lowercase. A
  /// String, not a Prisma enum — see development-conventions §7.3.
  ///
  /// Lowercase deliberately, and it must stay that way: the same literal is a
  /// segment of `limit-alert:{org}:{dimension}` in Redis and of the derived
  /// event id `limit:{org}:{dimension}:{threshold}:{gen}` that Domain E dedupes
  /// on. Upper-casing this column alone would give one fact two spellings, and
  /// the id is the half that cannot be respelled without invalidating every
  /// stored `event_id`. §7.3's SCREAMING_SNAKE rule is about enumerated domain
  /// values defined for a wire or database contract; these are internal keys of
  /// a config array, the same carve-out `SubscriptionPlanPrice.interval`
  /// already documents.
  dimension String @db.VarChar(32)

  /// Incremented once per RECOVERY, never per threshold cleared: falling from
  /// 100% to 5% is one recovery, and a counter that skipped values would be a
  /// step counter nobody could explain later.
  generation Int @default(0)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([organizationId, dimension])
  @@map("limit_alert_generations")
}
