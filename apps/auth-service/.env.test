# E2E-test environment. Loaded by `npm run test:e2e:auth` (root script) via
# dotenv-cli, which runs from the REPO ROOT — every relative path below is
# therefore repo-root-relative, not service-relative like the ones in `.env`.
#
# The only meaningful difference from `.env` is the database NAME. It is a
# different database on the SAME postgres-auth container — created by
# docker/postgres-auth/init-test-db.sh (root docker-compose.yml), and the name
# below MUST match AUTH_TEST_DB_NAME in the root `.env`. resetDatabase()
# TRUNCATEs every table before every single test, so a suite pointed at the dev
# database by mistake is one typo away from deleting the developer's own data —
# a distinct name is what turns that typo into a loud connection error instead
# of a silent one.
#
# SEED_ON_BOOTSTRAP is false here on purpose — the test bootstrap calls
# DatabaseSeeder.seed() explicitly (a bare TestingModule does not reliably fire
# Nest lifecycle hooks), so leaving it on would mean two seeding paths, one of
# which only sometimes runs.

# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL = postgresql://postgres:password123456789@localhost:5432/synapsedesk_auth_test?schema=public

# Redis (rate limiting, caching)
REDIS_URL = redis://localhost:6379

# NATS
NATS_URL = nats://localhost:4222

# gRPC
GRPC_HOST = 0.0.0.0
GRPC_PORT = 5001

# JWT secrets (minimum 32 chars, store in AWS Secrets Manager for production)
# Generated by `npm run keys:generate` at the repo root. PRIVATE half — this is
# the only service that may sign access tokens. Never copy it elsewhere.
JWT_ACCESS_PRIVATE_KEY_PATH = ./apps/auth-service/secrets/jwt-access.key
JWT_ACCESS_EXPIRES_IN = 15m

REFRESH_TOKEN_TTL_DAYS = 7
TRUSTED_DEVICE_TTL_DAYS = 30
PASSWORD_RESET_TTL_MINUTES = 30

# Removed: the refresh token is opaque random bytes, not a JWT (see env.validation.ts)
# JWT_REFRESH_SECRET = OCcXZgtcZXOuPxCVNqqfhVfq1C4FNF6mU3RwUUsQaOz
# JWT_REFRESH_EXPIRES_IN = 7d

JWT_2FA_PRIVATE_KEY_PATH = ./apps/auth-service/secrets/jwt-2fa.key
JWT_2FA_EXPIRES_IN  = 5m
JWT_TENANT_SELECTION_EXPIRES_IN = 5m

# Invitations
INVITATION_TTL_DAYS = 7

# Two-Factor Authentication
APP_NAME = SynapseDesk
TWO_FACTOR_MASTER_KEY = dev_only_2fa_master_key_change_me_32chars
TWO_FACTOR_TIME_TOLERANCE = 1
BACKUP_CODES_PER_USER = 10
BACKUP_CODES_LOW_WARNING_THRESHOLD = 2
BACKUP_CODE_TTL_DAYS = 30

# Password hashing
# 4, not 12. bcrypt's cost is the point in production and pure overhead here:
# resetDatabase() re-seeds before EVERY test, and each seed hashes the Super
# Admin password. At 12 rounds that is ~300ms x every test in the suite, spent
# proving nothing. Nothing under test asserts on the cost factor itself.
BCRYPT_ROUNDS = 4

# Links embedded in notifications (rendered by notification-service)
APP_WEB_URL = http://localhost:3000

# Firebase (Google sign-in). Path to the service-account JSON from
# Firebase console > Project settings > Service accounts > Generate new key.
# The file itself is gitignored — it is a bearer credential for the whole project.
FIREBASE_SERVICE_ACCOUNT_PATH = ./apps/auth-service/serviceAccountKey.json

# OAuth (GitHub)
# GOOGLE_CLIENT_ID =...
# GOOGLE_CLIENT_SECRET =...
GITHUB_CLIENT_ID = ...
GITHUB_CLIENT_SECRET = ...

# OTP settings
OTP_LENGTH = 6
OTP_EXPIRY_MINUTES = 10
OTP_MAX_ATTEMPTS = 5

# Node
NODE_ENV = development
LOG_LEVEL = debug

# Bootstrap seeding (src/prisma/seed.ts) — idempotent, runs on every startup
SEED_ON_BOOTSTRAP = false

# System actor: owns the global system roles. Cannot log in (no password, locked).
SYSTEM_USER_EMAIL = system@synapsedesk.internal
SYSTEM_USER_FULL_NAME = SynapseDesk System

# First platform Super Admin. Password is applied on creation only — change it
# through the API afterwards, and never reuse this value in production.
SUPER_ADMIN_EMAIL = superadmin@synapsedesk.io
SUPER_ADMIN_FULL_NAME = Platform Super Admin
SUPER_ADMIN_PASSWORD = ChangeMe_SuperAdmin_2026

# storage-service, for avatar uploads
STORAGE_SERVICE_URL = localhost:50253

# Billing — a fake secret is enough for the suite: the webhook tests SIGN their
# payloads with this same value through the real Stripe SDK, so verification is
# genuinely exercised rather than stubbed. The API key is deliberately absent,
# which keeps the "billing not configured" path on the same run.
STRIPE_WEBHOOK_SECRET = whsec_test_secret_for_the_e2e_suite

# Which build is this? Baked by the image build; these local
# values stand in for the ARGs the Dockerfile injects.
APP_VERSION = 0.0.0-local
BUILD_SHA = 0000000000000000000000000000000000000000
BUILD_TIME = 1970-01-01T00:00:00.000Z
