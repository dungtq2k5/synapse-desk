    "@types/jest": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^7.9.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
