    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.0",
    "@synapsedesk/common": "*",
    "@synapsedesk/grpc-proto": "*",
    "bcrypt": "^6.0.0",
