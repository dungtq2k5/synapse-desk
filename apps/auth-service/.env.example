# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL =

# Redis (rate limiting, caching)
REDIS_URL =

# NATS
NATS_URL =

# gRPC
GRPC_HOST =
GRPC_PORT =

# JWT secrets (minimum 32 chars, store in AWS Secrets Manager for production)
# Generated by `npm run keys:generate` at the repo root. PRIVATE half — this is
# the only service that may sign access tokens. Never copy it elsewhere.
JWT_ACCESS_PRIVATE_KEY_PATH =
JWT_ACCESS_EXPIRES_IN =

REFRESH_TOKEN_TTL_DAYS =
TRUSTED_DEVICE_TTL_DAYS =
PASSWORD_RESET_TTL_MINUTES =

# Removed: the refresh token is opaque random bytes, not a JWT (see env.validation.ts)
# JWT_REFRESH_SECRET = OCcXZgtcZXOuPxCVNqqfhVfq1C4FNF6mU3RwUUsQaOz
# JWT_REFRESH_EXPIRES_IN = 7d

JWT_2FA_PRIVATE_KEY_PATH =
JWT_2FA_EXPIRES_IN  =
JWT_TENANT_SELECTION_EXPIRES_IN =

# Invitations
INVITATION_TTL_DAYS =

# Two-Factor Authentication
APP_NAME =
TWO_FACTOR_MASTER_KEY =
TWO_FACTOR_TIME_TOLERANCE =
BACKUP_CODES_PER_USER =
BACKUP_CODES_LOW_WARNING_THRESHOLD =
BACKUP_CODE_TTL_DAYS =

# Password hashing
BCRYPT_ROUNDS =

# Links embedded in notifications (rendered by notification-service)
APP_WEB_URL =

# Firebase (Google sign-in). Path to the service-account JSON from
# Firebase console > Project settings > Service accounts > Generate new key.
# The file itself is gitignored — it is a bearer credential for the whole project.
FIREBASE_SERVICE_ACCOUNT_PATH =

# OAuth (GitHub)
# GOOGLE_CLIENT_ID = ...
# GOOGLE_CLIENT_SECRET = ...
GITHUB_CLIENT_ID =
GITHUB_CLIENT_SECRET =

# OTP settings
OTP_LENGTH =
OTP_EXPIRY_MINUTES =
OTP_MAX_ATTEMPTS =

# Node
NODE_ENV =
LOG_LEVEL =

# Bootstrap seeding (src/prisma/seed.ts) — idempotent, runs on every startup
SEED_ON_BOOTSTRAP =

# System actor: owns the global system roles. Cannot log in (no password, locked).
SYSTEM_USER_EMAIL =
SYSTEM_USER_FULL_NAME =

# First platform Super Admin. Password is applied on creation only — change it
# through the API afterwards, and never reuse this value in production.
SUPER_ADMIN_EMAIL =
SUPER_ADMIN_FULL_NAME =
SUPER_ADMIN_PASSWORD =
