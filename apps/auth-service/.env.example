# auth-service — every variable it reads, in the shared section order.
# Copy to `.env` and fill in real values; names and placeholders only here.

# ---------------------------------------------------------------- 1 RUNTIME

NODE_ENV = development
LOG_LEVEL = log

# The gRPC server the gateway and sibling services call.
GRPC_HOST = 0.0.0.0
GRPC_PORT = 5001

# ---------------------------------------------------------------- 2 BUILD
# Injected by the image build (Dockerfile ARGs) — a container has no `.git`
# to ask at runtime. Local runs use stand-in values; missing values refuse to
# boot rather than report "unknown".

APP_VERSION = 0.0.0-local
BUILD_SHA = 0000000000000000000000000000000000000000
BUILD_TIME = 1970-01-01T00:00:00.000Z

# ---------------------------------------------------------------- 3 DATA

# Domain A's OWN database. Cross-service ids carry no foreign key because no
# other service can reach this Postgres.
DATABASE_URL = postgresql://user:password@localhost:5432/synapsedesk_auth?schema=public

# Rate limiting and caching.
REDIS_URL = redis://localhost:6379

# ----------------------------------------------------------------4 MESSAGING

NATS_URL = nats://localhost:4222
# The NATS server's HTTP monitor, for JetStream health checks.
NATS_MONITOR_URL = http://localhost:8222

# ---------------------------------------------------------------- 5 PEERS

# storage-service, for avatar uploads.
STORAGE_SERVICE_URL = localhost:50253

# ---------------------------------------------------------------- 6 AUTH & SECRETS

# Generated by `npm run keys:generate` at the repo root. PRIVATE half — this
# is the only service that may sign access tokens. Never copy it elsewhere.
JWT_ACCESS_PRIVATE_KEY_PATH = ./secrets/jwt-access.key
JWT_ACCESS_EXPIRES_IN = 15m

# The refresh token is opaque random bytes, not a JWT — there is deliberately
# no JWT_REFRESH_SECRET (see env.validation.ts).
REFRESH_TOKEN_TTL_DAYS = 7
TRUSTED_DEVICE_TTL_DAYS = 30
PASSWORD_RESET_TTL_MINUTES = 30

# Separate 2FA signing pair, so a challenge token cannot verify where an
# access token is expected and vice versa.
JWT_2FA_PRIVATE_KEY_PATH = ./secrets/jwt-2fa.key
JWT_2FA_EXPIRES_IN = 5m
# Short-lived token carrying a multi-tenant login between its two legs.
JWT_TENANT_SELECTION_EXPIRES_IN = 5m

# Encrypts stored TOTP secrets at rest. Minimum 32 characters; losing it
# invalidates every enrolled second factor at once, so treat rotation as a
# migration, not a redeploy.
TWO_FACTOR_MASTER_KEY = a-random-string-of-at-least-32-chars
# How many 30-second TOTP windows either side still verify.
TWO_FACTOR_TIME_TOLERANCE = 1
BACKUP_CODES_PER_USER = 10
BACKUP_CODES_LOW_WARNING_THRESHOLD = 3
BACKUP_CODE_TTL_DAYS = 365

# Password hashing cost. 4 in .env.test for speed; 12+ in production.
BCRYPT_ROUNDS = 12

# One-time codes (email verification, password reset).
OTP_LENGTH = 6
OTP_EXPIRY_MINUTES = 10
OTP_MAX_ATTEMPTS = 5

# ---------------------------------------------------------------- 7 THIRD PARTY

# Firebase (Google sign-in). Path to the service-account JSON from Firebase
# console > Project settings > Service accounts > Generate new key. The file
# itself is gitignored — it is a bearer credential for the whole project.
FIREBASE_SERVICE_ACCOUNT_PATH = ./secrets/serviceAccountKey.json

# Stripe, for billing. From the Stripe dashboard (Developers > API keys).
# Optional: absent, every billing RPC answers UNAVAILABLE — the honest
# unconfigured state — rather than the service refusing to boot.
STRIPE_SECRET_KEY = sk_test_...
# The webhook ENDPOINT secret (Developers > Webhooks > your endpoint), not an
# API key. Consequence of getting it wrong: every Stripe webhook fails
# signature verification forever, silently, and entitlements stop moving —
# payments succeed at Stripe while plans never change here.
STRIPE_WEBHOOK_SECRET = whsec_...

# ---------------------------------------------------------------- 8 POLICY

# The 2FA issuer name shown in authenticator apps.
APP_NAME = SynapseDesk
# Base URL for links embedded in notifications (rendered by notification-service).
APP_WEB_URL = http://localhost:5173
INVITATION_TTL_DAYS = 7
# Mirror audit records to stdout as well as the database. Optional; defaults to true.
# AUDIT_LOG_TO_CONSOLE = true

# ---------------------------------------------------------------- 9 DEVELOPMENT

# Bootstrap seeding (src/prisma/seed.ts) — idempotent, runs on every startup.
SEED_ON_BOOTSTRAP = true

# System actor: owns the global system roles. Cannot log in (no password, locked).
SYSTEM_USER_EMAIL = system@example.com
SYSTEM_USER_FULL_NAME = System

# First platform Super Admin. Password is applied on creation only — change
# it through the API afterwards, and never reuse this value in production.
SUPER_ADMIN_EMAIL = admin@example.com
SUPER_ADMIN_FULL_NAME = Platform Admin
SUPER_ADMIN_PASSWORD = a-strong-password-of-12-chars-or-more
