// ticket-service owns Domain B (tickets, assignments, messages, attachments,
// AI summaries) plus the two Domain D tables the ownership map assigns here:
// ai_response_feedbacks and audit_logs.
//
// This is a SEPARATE physical database from postgres_auth. Every id below that
// names a user, department or organization is therefore a plain @db.Uuid with
// NO foreign key — Postgres cannot enforce one across databases, and that is
// the correct shape for service-per-database rather than a shortcut. The
// obligation it creates is validation at WRITE time over gRPC; see
// TicketsService.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../../docs/reference/erd/ticket-service.md"
  theme    = "default"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. TICKETS
// ==========================================
model Ticket {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// ONE GLOBAL SEQUENCE, not per tenant.
  ///
  /// Every tenant draws from the same counter, so org A may hold #1 and #7 while
  /// org B holds #2 through #6. A per-tenant sequence is a nicer product surface
  /// but needs a Postgres sequence per organization, created at onboarding —
  /// real complexity for a cosmetic gain. Revisit only if a customer-facing
  /// "our ticket numbers start at 1" requirement appears.
  ticketNumber BigInt @unique @default(autoincrement()) @map("ticket_number")

  /// The tenant boundary. No FK: `organizations` lives in postgres_auth.
  organizationId String @map("organization_id") @db.Uuid

  /// No FK: `users` lives in postgres_auth. Validated at write time via
  /// UserService.GetUser, never re-validated afterwards — Domain A only ever
  /// SOFT-deletes users, so this reference can never dangle.
  authorId String @map("author_id") @db.Uuid

  // Enumerated columns are plain strings, per conventions §7.3. The legal
  // values live in TicketSource / TicketStatus / TicketPriority in
  // @synapsedesk/common, which both this service and the gateway import.
  source   String @default("WEB") @db.VarChar(20)
  status   String @default("NEW") @db.VarChar(20)
  priority String @default("MEDIUM") @db.VarChar(20)

  title       String @db.VarChar(255)
  description String @db.Text

  /// DENORMALIZED cache of the current `ticket_assignments` row.
  ///
  /// Duplicated on purpose: the queue list filters and displays from these two
  /// columns rather than joining the assignment history on every row, and a
  /// join there is the difference between an indexed scan and a sort over every
  /// assignment a tenant ever made. The cost is that every assign/reassign/
  /// unassign must update BOTH — see TicketAssignment below.
  currentAssigneeId   String? @map("current_assignee_id") @db.Uuid
  currentDepartmentId String? @map("current_department_id") @db.Uuid

  escalatedAt DateTime? @map("escalated_at") @db.Timestamptz
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  deletedById String?   @map("deleted_by_id") @db.Uuid

  assignments    TicketAssignment[]
  statusChanges  TicketStatusChange[]
  messages       TicketMessage[]
  aiSummary     AiSummary?
  inboundEmails InboundEmail[]

  /// The queue view: "this tenant's tickets in status X".
  @@index([organizationId, status])
  /// "my tickets" for an agent.
  @@index([currentAssigneeId])
  /// A department's queue.
  @@index([currentDepartmentId])
  /// The non-agent visibility filter reads author_id inside the tenant scope.
  @@index([organizationId, authorId])
  @@map("tickets")
}

// ==========================================
// 2. TICKET ASSIGNMENTS (full history, one current)
// ==========================================
/// Inbound email idempotency
///
/// **One row per accepted message, written in the SAME transaction as the
/// ticket or message it produced.** Providers retry, and Cloudflare re-runs a
/// Worker that errored, so a redelivery must be a duplicate-key violation
/// rather than a second ticket.
///
/// The atomicity is the argument. Dedup recorded outside that transaction can
/// be written by a request that then fails — and the mail is then silently lost
/// on the retry that was supposed to recover it.
///
/// **Not `ticket_messages.client_message_id`**, which looks made for this and
/// cannot be: it is `@db.Uuid` where a `Message-ID` is an arbitrary string, and
/// it is unique per `(ticket_id, …)` when inbound dedup has to work BEFORE a
/// ticket exists — a redelivery of a new conversation's first mail has no
/// ticket to be scoped to.
///
/// **A Redis `SET NX` in front of this is an optimisation, never the
/// guarantee.** It saves two RPCs on a redelivery; the unique constraint below
/// is what makes the property true, and it is not removable on the grounds that
/// Redis is there.
model InboundEmail {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// The message's `Message-ID` header, or a synthesized digest when it had
  /// none.
  ///
  /// **255, not 998, and the unit is why.** This column is half of the unique
  /// index below, and Postgres refuses a btree tuple over roughly 2704 BYTES —
  /// while a length validator counts CHARACTERS. At 998 a multibyte header
  /// passes validation and then fails the insert with `index row size exceeds
  /// maximum`, which is not a duplicate-key error, so it surfaces as a 5xx and
  /// the provider retries it forever.
  ///
  /// The endpoint constrains the field to printable ASCII (RFC 5322 `msg-id`),
  /// which is what makes characters and bytes the same number.
  messageId String @map("message_id") @db.VarChar(255)

  /// What the message became. Null only for a row written before its ticket in
  /// some future path — today both are written together.
  ticketId String? @map("ticket_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// **Tenant-scoped, not global.** Two tenants can legitimately receive the
  /// same `Message-ID` — a customer CCs both, or a mailing list fans out — and
  /// a global constraint would drop the second one silently.
  /// **`SetNull`, never `Cascade`.** This row is the idempotency record for a
  /// delivery, and it has to outlive what it produced: cascade it away with the
  /// ticket and the provider's next retry of that same message is no longer a
  /// duplicate, so the deleted ticket comes straight back.
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([organizationId, messageId])
  @@index([ticketId])
  @@map("inbound_emails")
}

/// The status path a ticket took, one row per transition.
///
/// Written INSIDE the transaction that moves the status, which is the whole
/// point: `ticket.status_changed` is on NATS and is fire-and-forget, so a
/// history built from it would have holes whenever the broker was down. An
/// admin trail is allowed those (`AuditPublisher` says so); a screen showing a
/// customer what happened to their ticket is not.
///
/// Reassignments are NOT here — `ticket_assignments` is their history and
/// carries more than this shape could. `GET /tickets/:id/history` is status
/// only, and says so.
model TicketStatusChange {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid

  /// Denormalized from the parent, like every other table here: the tenant
  /// filter must not need a join to apply.
  organizationId String @map("organization_id") @db.Uuid

  /// TicketStatus. NULL only on a row recording a ticket's first status, which
  /// nothing writes today — every row comes from a transition, which has a
  /// `from`. Nullable so the column does not have to lie if creation ever
  /// records one.
  ///
  /// Nullable while `changed_by_id` beside it is not, and that is not an
  /// inconsistency: both describe a row nothing writes today, but a creation
  /// row would genuinely have no prior status AND would still have an author.
  fromStatus String? @map("from_status") @db.VarChar(20)

  /// TicketStatus.
  toStatus String @map("to_status") @db.VarChar(20)

  /// No FK: postgres_auth. NOT nullable, and that is a fact about the write
  /// path rather than a preference: `transition` loads the ticket through
  /// `tenantScope`, which refuses a caller with no `sub`, so no transition can
  /// happen without an actor. A system-driven one — a future auto-close sweep —
  /// would have to enter somewhere other than `transition`, and this column
  /// should be revisited then rather than pre-emptively made to lie.
  changedById String @map("changed_by_id") @db.Uuid

  /// Free text, bounded by `MAX_STATUS_CHANGE_REASON_LENGTH` at BOTH edges.
  ///
  /// Not the same shape as `ticket_assignments.reason`, which is a closed
  /// `ReassignmentReason` enum. A reassignment answers "which of six reasons";
  /// a status change answers "what happened", which no enum this system could
  /// write would cover.
  ///
  /// **Agent-facing.** It is stripped for a caller without queue access on the
  /// way out, exactly as an internal note is (ADR 0023) — the ticket's author
  /// is a reader of their own history, and "duplicate of #4127, customer keeps
  /// reopening" is the shape this field takes. Their OWN reasons survive.
  ///
  /// Being tenant prose, it also never travels into an audit row or onto
  /// `ticket.status_changed`. Two different boundaries, both load-bearing: one
  /// keeps it out of an operator's log, the other keeps it away from the person
  /// it is about.
  reason String? @db.Text

  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// The history read, which is always one ticket oldest-first.
  @@index([ticketId, changedAt])
  @@map("ticket_status_changes")
}

/// Every assignment a ticket has ever had, not just the live one.
///
/// The history is the point: "who was working this when it went wrong?" is not
/// answerable from a single mutable column. `is_current` marks the live row,
/// and a partial unique index applied by the seeder guarantees there is at most
/// one of them per ticket:
///
/// ```sql
///   CREATE UNIQUE INDEX ticket_assignments_current_key
///     ON ticket_assignments (ticket_id) WHERE is_current = true;
/// ```
///
/// Partial, so it cannot be expressed as `@@unique` here — the same discipline
/// as Domain A's `users_org_email_key` and `user_departments_primary_key`, and
/// the same reason: it is the only thing that makes two concurrent reassign
/// calls resolve to one winner rather than two live assignments.
model TicketAssignment {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid

  /// No FK: postgres_auth. Validated at write time.
  assignedToId String @map("assigned_to_id") @db.Uuid

  /// Nullable, and nothing writes a null: `writeAssignment` is the only writer
  /// and takes `requireActor(context)`. It was meant for a system assignment —
  /// auto-routing, escalation rules — which does not exist yet and would need
  /// an entry point that is not this one, since `load` refuses a caller with no
  /// identity. known-gaps #12.
  assignedById String? @map("assigned_by_id") @db.Uuid

  /// No FK: `departments` lives in postgres_auth.
  departmentId String @map("department_id") @db.Uuid

  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  unassignedAt DateTime? @map("unassigned_at") @db.Timestamptz

  /// ReassignmentReason. Recorded because "why did this move?" is the question
  /// an escalation review actually asks.
  reason String @default("INITIAL") @db.VarChar(20)

  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, isCurrent])
  @@index([assignedToId, createdAt(sort: Desc)])
  @@map("ticket_assignments")
}

// ==========================================
// 3. TICKET MESSAGES (the thread)
// ==========================================
model TicketMessage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid

  /// null for an AI-generated message: no user wrote it, and attributing one
  /// would put words in a real person's mouth in the audit trail.
  senderId String? @map("sender_id") @db.Uuid

  content String @db.Text

  isAiGenerated Boolean @default(false) @map("is_ai_generated")

  /// Agent-only. Stripped in the WHERE clause for a non-agent's fetch, never
  /// fetched-then-filtered — see TicketMessagesService.
  isInternalNote Boolean @default(false) @map("is_internal_note")

  /// Set when this message was REFUSED as prompt injection.
  ///
  /// **A filter, not a label.** The transcript builders exclude these, so a
  /// refused question cannot reach a later reformulation. Instructing a model
  /// to ignore an injection sitting in its own context is the reliance Layer A
  /// exists because you cannot make; excluding the row is a mechanism.
  ///
  /// **Not the same shape as `isInternalNote` above, and the difference is the
  /// point.** An internal note must never reach the caller — so it is stripped
  /// in the WHERE clause. A refused message MAY reach the caller: it is the
  /// record of what somebody attempted and stays visible in the thread. What it
  /// must not reach is a prompt. Two different risks, two different mechanisms.
  ///
  /// The row survives for the same reason `redactedAt` keeps its row: its
  /// position in the timeline is real, and what somebody attempted is worth
  /// keeping.
  excludedFromAiContext Boolean @default(false) @map("excluded_from_ai_context")

  /// `AnswerStatus` for an AI message. NULL for a human one.
  ///
  /// **For reading a thread, not for analytics.** An agent scrolling a
  /// conversation should be able to tell a refusal from an escalation from a
  /// real answer, which today is impossible: `appendAi` stores no status and
  /// the one in the WebSocket frame is never persisted.
  ///
  /// **The knowledge-gap question is already a ledger query** — generations
  /// with empty `retrieved_chunk_ids`. A second report built off
  /// this column would eventually disagree with that one, and the ledger is the
  /// half that money is computed from.
  answerStatus String? @map("answer_status") @db.VarChar(30)

  /// A DENORMALIZED CONVENIENCE for per-message display
  ///
  /// These were token metering before the ledger existed. They are not any
  /// more: **the quota gate sums `ai_generations`, never these**, and
  /// `rag-service` writes that ledger row itself at the moment it spends. Kept
  /// so a thread can show "answered by X, 400 tokens" without a cross-service
  /// join.
  ///
  /// **Do not let a second metering path grow back here.** A column that looks
  /// like spend and is not gated on is worse than no column: someone sums it,
  /// gets a number close enough to be believable, and reports a figure the cap
  /// was never computed from. They are nullable and frequently NULL — the
  /// `invokeAi` path leaves them empty because the authoritative numbers are
  /// already in the ledger row rag-service wrote.
  modelName        String? @map("model_name") @db.VarChar(100)
  promptTokens     Int?    @map("prompt_tokens")
  completionTokens Int?    @map("completion_tokens")

  /// Set when a message is EDITED, so the thread can show "edited" without a
  /// separate revision table.
  editedAt DateTime? @map("edited_at") @db.Timestamptz

  /// Set when a message is REDACTED. The row survives — its position in the
  /// timeline is the thing worth keeping, so `content` is replaced rather than
  /// the row deleted. Same reasoning as Domain E's notifications choosing
  /// `archived_at` over `deleted_at`.
  redactedAt   DateTime? @map("redacted_at") @db.Timestamptz
  redactedById String?   @map("redacted_by_id") @db.Uuid

  /// The SENDER's own id for this message.
  ///
  /// **Exists because WebSocket clients retry in a way HTTP clients do not.** A
  /// user clicks Send once; a socket reconnects, and a client holding an unacked
  /// message re-emits it. That is correct client behaviour and it double-posts.
  ///
  /// Deduped on `(ticket_id, client_message_id)` by a PARTIAL unique index — see
  /// `applyPartialIndexes()` in the seeder. Partial because the column is NULL
  /// for every HTTP-created message, and Postgres does not treat NULLs as equal,
  /// so a full unique index would admit unlimited NULL rows while still costing
  /// a full index. The filter makes that explicit rather than accidental.
  clientMessageId String? @map("client_message_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket      Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ==========================================
// 4. MESSAGE ATTACHMENTS
// ==========================================
/// The table and its validation exist now; the actual upload does not.
///
/// No object storage is decided anywhere in this repo yet — the same deferral
/// Domain A made for `/users/me/avatar`. The DTO enforces the mime allowlist,
/// the size cap and the per-message count; the upload endpoint answers 503
/// UNAVAILABLE rather than not existing, so a client can tell "not built yet"
/// from "broken".
model MessageAttachment {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String @map("message_id") @db.Uuid

  fileName      String @db.VarChar(255)
  fileUrl       String @db.Text
  fileSizeBytes BigInt @map("file_size_bytes")
  mimeType      String @map("mime_type") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// Cascade: an attachment has no meaning without its message, and a redacted
  /// message keeps its row, so this only fires when a ticket is hard-deleted.
  message TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

// ==========================================
// 5. AI SUMMARIES (one per ticket)
// ==========================================
/// 1:1 with a ticket — `@unique` on ticket_id is what makes re-generation an
/// UPSERT rather than an append. A ticket has one current summary; the old one
/// is not history worth keeping, because it summarised a thread that has since
/// moved on.
model AiSummary {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId String @unique @map("ticket_id") @db.Uuid

  summaryText     String @map("summary_text") @db.Text
  suggestedAction String @map("suggested_action") @db.Text
  confidenceScore Float  @map("confidence_score")
  modelName       String @map("model_name") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ai_summaries")
}

// ==========================================
// 6. AI RESPONSE FEEDBACK (Domain D table, owned here)
// ==========================================
/// `@@unique([ticketMessageId, userId])` makes submitting feedback an UPSERT:
/// a user may change their mind from a thumbs-up to a thumbs-down, and a second
/// row would double-count them in every quality metric.
///
/// No FK to ticket_messages despite both living in this database: the message
/// may be redacted and the feedback should survive it, and a cascade here would
/// silently delete the signal that a bad answer was reported.
model AiResponseFeedback {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  ticketMessageId String @map("ticket_message_id") @db.Uuid

  /// No FK: postgres_auth.
  userId String @map("user_id") @db.Uuid

  /// Carried so the list endpoint can scope without joining back through
  /// messages to tickets. Denormalized for the same reason as
  /// `tickets.current_assignee_id`.
  organizationId String @map("organization_id") @db.Uuid

  /// 1 or -1 — a thumb, not a scale. Constrained in the application layer and
  /// by a CHECK the seeder applies; Prisma expresses neither.
  rating Int

  feedbackText     String?  @map("feedback_text") @db.Text
  citationAccurate Boolean? @map("citation_accurate")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([ticketMessageId, userId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("ai_response_feedbacks")
}

// ==========================================
// 7. AUDIT LOGS (Domain D table, owned here)
// ==========================================
/// Populated ONLY by the NATS consumer, never by an RPC.
///
/// The proto for this module deliberately declares no Create message: a write
/// path that does not exist in the contract cannot be added by accident, and
/// the trail's value depends entirely on nobody being able to write to it
/// directly.
model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// NULL for a platform-level act (RDM §1.7) — the event belongs to the
  /// platform, not to the customer it touched. That is why this is nullable and
  /// why the consumer must never coerce it to the actor's own tenant.
  organizationId String? @map("organization_id") @db.Uuid

  /// null for system and cron actors, which have no user row acting for them.
  userId String? @map("user_id") @db.Uuid

  action       String  @db.VarChar(100)
  resourceType String? @map("resource_type") @db.VarChar(50)
  resourceId   String? @map("resource_id") @db.Uuid

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  /// A REDACTED before/after diff. Never a password hash, a 2FA secret or any
  /// token hash — the publisher whitelists what it records.
  metadata Json @default("{}")

  /// The PUBLISHER's clock, not the consumer's: a consumer restart must not
  /// backdate a backlog of events to the moment it caught up.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action])
  @@index([userId])
  @@map("audit_logs")
}

/// The daily ticket rollup.
///
/// **Why a table and not a query.** `/analytics/overview` over a quarter is an
/// aggregation across every ticket in a tenant, ON THE TABLE SERVING TICKET
/// CREATION. A Monday-morning dashboard load competing with the hot path is the
/// failure mode, and no amount of endpoint design fixes it.
///
/// **Not a materialized view**: those cannot be expressed in Prisma, refresh
/// whole rather than incrementally, and a `REFRESH` over a quarter is the same
/// hot-path competition moved to a different hour. A plain table written by an
/// idempotent daily job is testable, backfillable and incremental.
///
/// **SUMS AND COUNTS, never averages.** An average of daily averages is not the
/// average — it weights a Tuesday with 3 tickets equally with a Monday with
/// 300. Every rate and mean is computed at READ time from a sum and a count.
/// This is the single most common way a metrics table produces confidently
/// wrong numbers, and it is unrecoverable after the fact because the inputs are
/// gone.
model TicketDailyStat {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  /// A DATE in the TENANT'S timezone, not UTC.
  ///
  /// A tenant at UTC+7 whose Monday starts at 17:00 Sunday UTC would otherwise
  /// see every daily figure split across two rows, and no consumer could
  /// reassemble them.
  day DateTime @db.Date

  /// NULL is the tenant-wide row for tickets with no department.
  ///
  /// Kept as a real dimension rather than summed away, because
  /// `?departmentId=` has to agree with `GET /tickets?departmentId=` and a
  /// tenant-only rollup could not answer it.
  departmentId String? @map("department_id") @db.Uuid

  ticketsCreated   Int @default(0) @map("tickets_created")
  ticketsResolved  Int @default(0) @map("tickets_resolved")
  ticketsEscalated Int @default(0) @map("tickets_escalated")

  /// The deflection PAIR, and both are bucketed on the CONVERSATION'S day.
  ///
  /// A cohort rather than two independent event counts: a conversation started
  /// Sunday and deflected Monday counts on Sunday for both, so the ratio is
  /// "of conversations started that day, how many needed no human" and cannot
  /// exceed 1. Bucketing the numerator on its own resolution day would produce
  /// deflection rates above 100% on any day following a busy one.
  ///
  /// The cost is that today's figure is PROVISIONAL until its conversations
  /// close — which is why the job is re-runnable and why ranges including today
  /// cache briefly.
  chatConversations             Int @default(0) @map("chat_conversations")
  chatResolvedWithoutEscalation Int @default(0) @map("chat_resolved_without_escalation")

  firstResponseSecondsSum Int @default(0) @map("first_response_seconds_sum")
  firstResponseCount      Int @default(0) @map("first_response_count")

  /// Split from the human figures deliberately.
  ///
  /// An AI reply in 2 seconds genuinely IS a first response, and blending it
  /// with human response time produces a headline that improves whenever AI
  /// usage rises. That is the metric measuring itself.
  aiFirstResponseSecondsSum Int @default(0) @map("ai_first_response_seconds_sum")
  aiFirstResponseCount      Int @default(0) @map("ai_first_response_count")

  resolutionSecondsSum Int @default(0) @map("resolution_seconds_sum")
  resolutionCount      Int @default(0) @map("resolution_count")

  feedbackPositive      Int @default(0) @map("feedback_positive")
  feedbackNegative      Int @default(0) @map("feedback_negative")
  citationAccurateCount Int @default(0) @map("citation_accurate_count")
  citationRatedCount    Int @default(0) @map("citation_rated_count")

  /// When the job that wrote this row ran.
  ///
  /// Load-bearing rather than decorative: it goes into the analytics CACHE KEY
  /// for closed ranges, so a backfill correction invalidates the
  /// affected entries automatically instead of serving known-wrong numbers for
  /// a day. It is also what an export records so two people exporting "last
  /// quarter" a week apart can tell why their numbers differ.
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz

  /// Prisma cannot express a unique index over a NULLable column that treats
  /// NULLs as equal, and `department_id` is NULL for unassigned tickets — so
  /// the real constraint is a PARTIAL pair applied by the seeder. Declaring
  /// `@@unique` here would silently permit duplicate tenant-wide rows.
  @@index([organizationId, day])
  @@map("ticket_daily_stats")
}

/// The daily per-agent rollup.
///
/// Separate from `ticket_daily_stats` rather than a wider dimension on it: an
/// agent is a person and a department is a queue, and one row per (day,
/// department, agent) would multiply the table by agent count for every metric
/// that has nothing to do with agents.
model AgentDailyStat {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  organizationId String   @map("organization_id") @db.Uuid
  day            DateTime @db.Date

  /// No FK — `users` lives in postgres_auth (RDM §1.13). The display name is
  /// hydrated at read time by the gateway, which is the same cross-service
  /// reference pattern used everywhere else.
  agentId String @map("agent_id") @db.Uuid

  assigned     Int @default(0)
  resolved     Int @default(0)
  messagesSent Int @default(0) @map("messages_sent")

  resolutionSecondsSum Int @default(0) @map("resolution_seconds_sum")
  resolutionCount      Int @default(0) @map("resolution_count")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz

  /// `agent_id` is NOT NULL here, so this one CAN be expressed.
  @@unique([organizationId, day, agentId])
  @@index([organizationId, day])
  @@map("agent_daily_stats")
}

/// An async analytics export.
///
/// **`GET /analytics/export` is not a read**: it creates a job, produces a file
/// and returns a download URL. So it needs an owner, and ticket-service owns
/// most of the source data.
///
/// **An export is a SNAPSHOT with a timestamp in it.** Two people exporting
/// "last quarter" a week apart get different numbers if a backfill ran between,
/// so the file records when it was generated and from which rollup run — or it
/// becomes a disputed number in a meeting with nothing to settle it.
model AnalyticsExport {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  /// No FK — postgres_auth. Who asked, so an operator can answer "who exported
  /// our ticket history".
  requestedById String @map("requested_by_id") @db.Uuid

  /// AnalyticsExportKind.
  kind String @db.VarChar(30)

  /// The range, as the tenant's local dates — the same domain the rollups use.
  fromDay DateTime @map("from_day") @db.Date
  toDay   DateTime @map("to_day") @db.Date

  departmentId String? @map("department_id") @db.Uuid

  /// The tenant's timezone when the export was requested.
  ///
  /// `from_day`/`to_day` are DATES in the TENANT'S local terms — the same
  /// domain the rollups bucket by — and the row exports compare them against a
  /// `timestamptz`. Without the zone, a tenant at UTC+7 asking for August gets
  /// rollup rows over local August and ticket rows over UTC August: seven hours
  /// of skew at each end, in opposite directions, from one stated range.
  ///
  /// Stored rather than read in the worker for the same reason as
  /// `unrestricted`: the renderer has no caller, and a cross-service read
  /// inside the queue's one slot is the wrong place for it. NULL means UTC,
  /// which is what `safeTimezone` already resolves an absent zone to.
  timezone String? @db.VarChar(64)

  /// Whether the requester could see EVERY ticket when they asked.
  ///
  /// Captured at request time and not re-derived: the renderer runs later, in a
  /// worker with no `CallerContext`, and a permission can be revoked in
  /// between. An export must contain what the person could see when they asked
  /// — re-deriving would either widen it after a grant or fail it after a
  /// revoke, and neither is what they requested.
  ///
  /// False means the renderer restricts to tickets they authored or are
  /// assigned — the same predicate `TicketAccessService.visibilityScope`
  /// applies to the list.
  unrestricted Boolean @default(false)

  /// The per-kind predicates that are NOT shared — ticket status and assignee,
  /// audit action and resource type. `Json` because three kinds have three
  /// shapes and a column per predicate would be mostly null.
  ///
  /// **Storage, never a contract.** Validated at the service against a per-kind
  /// DTO on the way in and never read back as `any`.
  filters Json? @db.JsonB

  /// AnalyticsExportStatus.
  status String @default("PENDING") @db.VarChar(20)

  /// The object in storage. Absent until the file exists.
  objectPath String? @map("object_path") @db.Text
  rowCount   Int?    @map("row_count")

  /// **The disputed-number guard.** The newest `computed_at` across the rollup
  /// rows this file was built from, recorded here AND written into the file. A
  /// reader comparing two exports can then see whether the data was recomputed
  /// between them rather than guessing.
  rollupComputedAt DateTime? @map("rollup_computed_at") @db.Timestamptz

  /// Why it failed. Present exactly when `status = FAILED`.
  errorLog String? @map("error_log") @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("analytics_exports")
}

/// The HEARTBEAT.
///
/// **One row per job name, and the deepest fix in that document.** The jobs not
/// running was not the real problem; the real problem was that nothing anywhere
/// could tell you they were not running. A failed job at least logs. A job that
/// never runs logs nothing at all — which is precisely the case that occurred,
/// and it stayed invisible for two domains.
///
/// **Three copies of this table is CORRECT**, and this note
/// exists so nobody re-opens it. Service-per-database means each service
/// records its own jobs in its own failure domain: "did ingestion-service's
/// rollup run?" is a question about ingestion-service's database, and a shared
/// heartbeat service would report healthy while that database was unreachable —
/// the original bug, reintroduced with extra infrastructure. Three tables
/// holding different rows is not duplication of facts; no single fact is stored
/// twice.
///
/// The *behaviour* lives once, in `JobRunRecorder` (`libs/common`), over a
/// hand-written `JobRunStore` that each service binds to its own delegate.
/// `job-run-schema.spec.ts` asserts these three blocks stay identical — they
/// had already begun to drift in comments before it existed.
///
/// Not tenant-scoped: these jobs sweep across every tenant, so "did the rollup
/// run" is one question with one answer per service.
model JobRun {
  /// The job name from `SCHEDULED_JOBS`, or a step within one. The PK, so
  /// recording a run is a single upsert with no read first.
  jobName String @id @map("job_name")

  lastStartedAt   DateTime  @map("last_started_at")
  /// **Preserved across a failure**, deliberately. This is what the staleness
  /// alert reads, and clearing it on failure would turn "broken since Tuesday"
  /// into "never ran", losing the one piece of information worth having.
  ///
  /// Nullable because it is null until the FIRST success — which is how
  /// `checkStaleness` tells "never ran" from "stale".
  lastSucceededAt DateTime? @map("last_succeeded_at")

  lastDurationMs Int?    @map("last_duration_ms")
  /// Truncated by `JobRunRecorder` — a driver stack trace is kilobytes and the
  /// first line is what anybody reads.
  lastError      String? @map("last_error")

  /// Reset to 0 on success. A count that only ever grows is how a job failing
  /// every night for a month reads as one failure.
  consecutiveFailures Int @default(0) @map("consecutive_failures")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("job_runs")
}
