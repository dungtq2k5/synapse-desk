# E2E-test environment. Loaded by `npm run test:e2e:ticket` via dotenv-cli,
# which runs from the REPO ROOT — every relative path below would therefore be
# repo-root-relative (there are none today).
#
# The only meaningful difference from `.env` is the database NAME. It is a
# different database on the SAME container: resetDatabase() empties every table
# before every test, so a suite pointed at the dev database is one typo away
# from deleting the developer's own data.
#
# SEED_ON_BOOTSTRAP is false here because the test bootstrap calls the seeder
# explicitly — a bare TestingModule does not reliably fire Nest lifecycle hooks,
# and two seeding paths where one only sometimes runs is worse than one.

NODE_ENV = test

# Domain B's OWN database — a different physical Postgres from auth-service's.
# That separation is the whole reason cross-service ids carry no foreign key.
DATABASE_URL = postgresql://postgres:password123456789@localhost:5433/synapsedesk_ticket_test?schema=public

# Both directions: this service publishes ticket.* AND consumes audit.record.
NATS_URL = nats://localhost:4222

# The gRPC server the gateway calls. 5002, since auth-service holds 5001.
GRPC_HOST = 0.0.0.0
GRPC_PORT = 50252

# The gRPC client pointed back at auth-service, for write-time validation of
# author_id / assignee_id / department_id. There is no foreign key to do this.
AUTH_SERVICE_URL = localhost:5001

# Applies the partial unique index and the CHECK constraint on boot.
SEED_ON_BOOTSTRAP = false

# How long a sender may edit their own message.
MESSAGE_EDIT_WINDOW_MINUTES = 15

# rag-service (Python) is not started. Left unset on purpose: absent means every
# AI RPC answers UNAVAILABLE, which is the honest state and is what the §2.6
# tests assert. Set it when Domain C ships.

# storage-service, for message attachments (10-storage-service.md §3.2).
STORAGE_SERVICE_URL = localhost:50253

# Deliberately UNSET here, and exempted in the Joi schema. The AI suite spies on
# `RagClientService.isAvailable` to exercise both branches, so a value would
# change the default every other spec in this service runs under — without
# making any of them test more.

# The analytics export queue — ticket-service’s first queue.
REDIS_URL = redis://localhost:6379

# Which build is this? Baked by the image build; these local
# values stand in for the ARGs the Dockerfile injects.
APP_VERSION = 0.0.0-local
BUILD_SHA = 0000000000000000000000000000000000000000
BUILD_TIME = 1970-01-01T00:00:00.000Z
