// Domain E — postgres_notification. RDM Tables 23-25.
//
// The first slice of this schema shipped during hardening, because the AI quota
// alert became the first LOAD-BEARING consumer of `notification.in_app.create`:
// the alert was published correctly, idempotently, to the right audience, into
// a subject with no subscriber. Everything looked finished except that nobody
// was ever told.
//
// Completes it, and the seven columns added to `Notification` are what
// made the rest of Domain E UNBUILDABLE rather than merely incomplete:
// `actor_id` is how self-notifications are suppressed, `resource_*` is what
// bulk-read-by-ticket matches on, and `group_key`/`group_count` are the
// difference between a feature and a spam machine.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../../docs/reference/erd/notification-service.md"
  theme    = "default"
}

datasource db {
  provider = "postgresql"
}

/// RDM Table 23 — the per-recipient in-app feed.
///
/// One row per RECIPIENT rather than one per event with a recipient list: the
/// read pattern is "my unread notifications", and a list column would make that
/// a scan with an array predicate on the largest table Domain E will have.
model Notification {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// No FK: `organizations` lives in postgres_auth. Validated by the producer.
  organizationId String @map("organization_id") @db.Uuid

  /// No FK either — `users` is in postgres_auth. Resolved from the audience
  /// permission at delivery time by asking auth-service.
  recipientId String @map("recipient_id") @db.Uuid

  /// **The ORIGINATING event, never the transport subject**.
  ///
  /// `ticket.assigned`, `document.indexed`, `quota.exceeded`. This used to be
  /// written as `IN_APP_NOTIFICATION_PATTERN`, which is identical on every row
  /// — harmless with one producer and a blocker with two:
  ///
  ///   - `GET /notifications?type=` would match every row against every filter;
  ///   - preference resolution keys on `(type, channel)` (Table 25), so a user
  ///     could enable or disable EVERYTHING and nothing in between.
  type String @db.VarChar(100)

  /// NotificationPriority. CRITICAL bypasses quiet hours and digest batching.
  priority String @default("NORMAL") @db.VarChar(20)

  title String  @db.VarChar(255)
  body  String? @db.Text

  /// Deep-link payload for the SPA.
  data Json @default("{}") @db.JsonB

  actionUrl String? @map("action_url") @db.Text

  /// Who triggered it. NULL = the system, or AI.
  ///
  /// No FK — `users` is in postgres_auth. Exists so a consumer can suppress
  /// SELF-notifications: an agent who assigns a ticket to themselves must not
  /// be told about it, and getting that wrong is the first thing anybody
  /// notices by hand.
  actorId String? @map("actor_id") @db.Uuid

  /// NotificationResourceType — TICKET | DOCUMENT | USER | ORGANIZATION.
  resourceType String? @map("resource_type") @db.VarChar(50)

  /// What the notification is ABOUT, so opening ticket #1042 can clear all
  /// twelve of its notifications in one call rather than twelve.
  resourceId String? @map("resource_id") @db.Uuid

  /// Collapse key — `ticket:{ticketId}:message`, emitted by Domain B already.
  ///
  /// Multiple events with the same key become ONE row with an incremented
  /// `groupCount`. Without it `ticket.message_created` produces a notification
  /// per reply, and the user turns notifications off in week one.
  groupKey String? @map("group_key") @db.VarChar(200)

  /// How many events this row represents — "12 new messages on #1042".
  groupCount Int @default(1) @map("group_count")

  /// **The idempotency key, and it is DERIVED rather than generated.**
  ///
  /// `UNIQUE (recipient_id, event_id)` is what makes NATS redelivery harmless:
  /// the same threshold crossing produces the same id, so a second delivery is
  /// a duplicate-key violation the consumer catches rather than a second
  /// notification. A uuid here would make every retry a new row — and the quota
  /// alert is exactly the producer that retries.
  eventId String? @map("event_id") @db.VarChar(100)

  /// The recent event ids that INCREMENTED this group, newest first.
  ///
  /// Grouping and `event_id` idempotency pull in opposite directions: the
  /// INSERT is deduped by the unique index, but an increment has no such
  /// protection, so a redelivery can double-count.
  ///
  /// Bounded to the newest `GROUP_EVENT_WINDOW` entries by the `UPDATE` that
  /// writes it, so a busy group does not grow an unbounded array.
  groupEventIds String[] @map("group_event_ids") @db.VarChar(100)

  readAt     DateTime? @map("read_at") @db.Timestamptz
  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  /// Retention cutoff for the pruning job.
  /// This table grows faster than any other in the system.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  deliveries NotificationDelivery[]

  /// **No `deleted_at`, and that is an exception to RDM §1.6 rather than an
  /// oversight.** A notification is ephemeral by nature: `archived_at` is the
  /// user dismissing it and `expires_at` is retention. A tombstone of a
  /// dismissed badge is storage with no reader.
  ///
  /// The four PARTIAL indexes this table actually runs on are applied by
  /// `DatabaseSeeder` — Prisma cannot express `WHERE`. The declarations below
  /// are the ones Prisma CAN express; `@@unique([recipientId, eventId])` is
  /// deliberately absent because its partial form (`WHERE event_id IS NOT
  /// NULL`) is the one that lets two rows with a NULL event id coexist.
  @@index([recipientId, createdAt(sort: Desc)])
  @@index([organizationId])
  @@index([recipientId, resourceType, resourceId])
  @@index([expiresAt])
  @@map("notifications")
}

/// One auto-reply per address per TENANT per day.
///
/// **A table rather than Redis, and the reason is not convenience.** This
/// service has no Redis client, and adding one for a counter would put the loop
/// guard in a store a flush empties. A flushed limit re-opens the exchange it
/// exists to close — and a mail loop is the one failure whose blast radius is
/// somebody else's inbox.
///
/// **Owned by the SENDER, not the publisher.** A limit enforced where the event
/// is emitted counts intentions; enforced here it counts messages, and the loop
/// is made of messages.
///
/// **Keyed `(organization_id, email)`, not on the address alone.** The table
/// serves two purposes and they want different keys: loop prevention is a
/// property of a mailbox, while a rejection notice is per-tenant. Keyed
/// globally, a person who emails two of your tenants gets one courtesy reply
/// and silence from the second — and concludes that tenant's support address is
/// dead. This is the same reasoning `InboundEmail` records for `Message-ID`:
/// one correspondent may legitimately be talking to several tenants.
///
/// A loop then costs at most one reply per tenant per day, which is still
/// bounded — and bounded by the number of tenants that address is actually
/// writing to, not by the number that exist.
model InboundAutoReply {
  organizationId String   @map("organization_id") @db.Uuid
  email          String   @db.VarChar(320)
  lastSentAt     DateTime @map("last_sent_at") @db.Timestamptz

  @@id([organizationId, email])
  /// For the daily prune — rows older than the window are dead weight, and
  /// without a sweep this grows by one row per distinct stranger, forever.
  @@index([lastSentAt])
  @@map("inbound_auto_replies")
}

model NotificationDelivery {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  notificationId String @map("notification_id") @db.Uuid

  /// NotificationChannel — IN_APP | EMAIL | SMS | WEBHOOK.
  channel String @db.VarChar(20)

  /// DeliveryStatus. Distinct from `notifications.read_at`: sent is not read.
  status String @default("PENDING") @db.VarChar(20)

  /// DeliverySkipReason — `USER_PREFERENCE`, `QUIET_HOURS`,
  /// `UNVERIFIED_ADDRESS`, `ALREADY_SEEN_IN_APP`, `RATE_LIMITED`. The auditable
  /// alternative to a silent drop.
  skipReason String? @map("skip_reason") @db.VarChar(100)

  /// The address AT SEND TIME, snapshotted like `otps.target`. Preserved when
  /// the user later changes their contact details, so a delivery record still
  /// says where it actually went.
  target String? @db.VarChar(255)

  /// The provider's own id — an SMTP `Message-ID` or a Twilio SID. Stored now
  /// so provider delivery webhooks are additive later.
  providerMessageId String? @map("provider_message_id") @db.VarChar(255)

  attempts Int     @default(0)
  errorLog String? @map("error_log") @db.Text

  bullmqJobId String? @map("bullmq_job_id") @db.VarChar(100)

  sentAt      DateTime? @map("sent_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  failedAt    DateTime? @map("failed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// CASCADE per RDM §3: a hard-deleted notification takes its delivery rows
  /// with it. They describe an attempt to deliver something that no longer
  /// exists.
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([providerMessageId])
  @@map("notification_deliveries")
}

/// RDM Table 25 — per (user, type, channel) opt-in and batching.
///
/// **Ships WITH the producers, not after them**. The producers turn on the
/// volume and this is the only thing that lets a user survive it — and a user
/// who disables notifications in week one is not recovered by shipping
/// preferences in week three.
///
/// Resolution is exact `(type, channel)` → `('*', channel)` → a hard-coded
/// permissive default. A MISSING row is not an opt-out.
///
/// Quiet hours are deliberately NOT here: they are global user settings and
/// live on `users` in postgres_auth, which is why this table is keyed by type.
model NotificationPreference {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// No FK — postgres_auth. The CASCADE that RDM Table 25 specifies is not
  /// expressible across databases; a departed user's rows are cleaned up by the
  /// same retention story as their notifications.
  userId String @map("user_id") @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  /// A notification type, or `'*'` for the catch-all.
  type String @db.VarChar(100)

  /// NotificationChannel — IN_APP | EMAIL | SMS.
  channel String @db.VarChar(20)

  isEnabled Boolean @default(true) @map("is_enabled")

  /// DigestMode. `HOURLY`/`DAILY` are read by the resolver and have no
  /// scheduler yet — the column is what makes the job possible.
  digest String @default("IMMEDIATE") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, type, channel])
  @@index([organizationId])
  @@map("notification_preferences")
}

/// Where a person's push notifications go — one row per APP INSTALL.
///
/// **In this database rather than beside `device_sessions` in auth**, and the
/// distinction is a lifetime: a `DeviceSession` is keyed to a refresh-token
/// family and is rotated and revoked with it, while a push token outlives every
/// session, survives logout on most platforms, and is reissued by the OS on its
/// own schedule. Sharing a table would mean one revoke path deleting rows the
/// other still needs.
///
/// `userId` and `organizationId` are cross-service ids with no foreign key,
/// like every other id in this database (RDM §1.13).
model DeviceToken {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// The FCM registration token. **UNIQUE, and the uniqueness IS the
  /// mechanism**: the same install re-registering must UPDATE rather than
  /// accumulate, and a token FCM reassigns to a different user must move rather
  /// than duplicate — a shared tablet two people sign into must not deliver one
  /// person's notifications to the other. An upsert on this column does both,
  /// which `(user_id, token)` could not.
  token String @unique @db.VarChar(512)

  /// `IOS` | `ANDROID` | `WEB` — a String, not a Prisma enum
  /// (development-conventions §7.3).
  platform String @db.VarChar(20)

  /// For the settings screen — "iPhone 15, last used 3 days ago".
  deviceName String? @map("device_name") @db.VarChar(100)

  /// Touched on a successful send, so the settings list can say how stale a
  /// device is without a second table.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  /// **No soft delete, deliberately.** A dead token is not history worth
  /// keeping — it is a credential that no longer works, and every read of this
  /// table wants only live rows. A `deletedAt` here would mean every send has
  /// to filter it and a token FCM has already rejected would keep being
  /// counted in the device total a delivery row reports.
  @@index([userId])
  @@map("device_tokens")
}

/// The HEARTBEAT.
///
/// **One row per job name, and the deepest fix in that document.** The jobs not
/// running was not the real problem; the real problem was that nothing anywhere
/// could tell you they were not running. A failed job at least logs. A job that
/// never runs logs nothing at all — which is precisely the case that occurred,
/// and it stayed invisible for two domains.
///
/// **Four copies of this table is CORRECT**, and this note
/// exists so nobody re-opens it. Service-per-database means each service
/// records its own jobs in its own failure domain: "did ingestion-service's
/// rollup run?" is a question about ingestion-service's database, and a shared
/// heartbeat service would report healthy while that database was unreachable —
/// the original bug, reintroduced with extra infrastructure. Four tables
/// holding different rows is not duplication of facts; no single fact is stored
/// twice.
///
/// The *behaviour* lives once, in `JobRunRecorder` (`libs/common`), over a
/// hand-written `JobRunStore` that each service binds to its own delegate.
/// `job-run-schema.spec.ts` asserts these four blocks stay identical — they
/// had already begun to drift in comments before it existed.
///
/// Not tenant-scoped: these jobs sweep across every tenant, so "did the rollup
/// run" is one question with one answer per service.
model JobRun {
  /// The job name from `SCHEDULED_JOBS`, or a step within one. The PK, so
  /// recording a run is a single upsert with no read first.
  jobName String @id @map("job_name")

  lastStartedAt   DateTime  @map("last_started_at")
  /// **Preserved across a failure**, deliberately. This is what the staleness
  /// alert reads, and clearing it on failure would turn "broken since Tuesday"
  /// into "never ran", losing the one piece of information worth having.
  ///
  /// Nullable because it is null until the FIRST success — which is how
  /// `checkStaleness` tells "never ran" from "stale".
  lastSucceededAt DateTime? @map("last_succeeded_at")

  lastDurationMs Int?    @map("last_duration_ms")
  /// Truncated by `JobRunRecorder` — a driver stack trace is kilobytes and the
  /// first line is what anybody reads.
  lastError      String? @map("last_error")

  /// Reset to 0 on success. A count that only ever grows is how a job failing
  /// every night for a month reads as one failure.
  consecutiveFailures Int @default(0) @map("consecutive_failures")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("job_runs")
}

/// A tenant-registered receiver for outbound webhooks.
///
/// **Tenant configuration, not a user setting** — which is why `WEBHOOK` is
/// absent from `PREFERENCE_CHANNELS` and why deliveries get their own table:
/// `notification_deliveries` answers "did we tell this person", and a webhook
/// is not telling a person anything.
model WebhookEndpoint {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  /// HTTPS only, and the string here is NOT the control: the URL is validated
  /// when saved and RESOLVED when delivered to, and DNS can change in between.
  /// The real check runs at connection time on every resolved address — see
  /// `webhook-target.guard.ts`.
  url String @db.VarChar(2000)

  description String? @db.VarChar(500)

  /// `NotificationType` values (`ticket.assigned`) — the PUBLIC vocabulary,
  /// never the NATS subject. **Never empty**: an endpoint subscribed to zero
  /// types is refused at creation rather than created silently useless, and an
  /// empty list never means "all" (known-gap #25 is what that ambiguity costs
  /// from the consuming side).
  eventTypes String[] @map("event_types")

  /// **Plaintext at rest, like `inboundToken`, and unlike every other secret
  /// here.** The others are hashed because we only ever RECOGNISE them; this
  /// one is REPLAYED — an HMAC over every send — so a digest is unusable.
  /// Unguessable (32 random bytes, hex) and rotatable, never derived.
  secret String @db.VarChar(64)

  /// Rotation's overlap, as STATE rather than a job somebody runs: while
  /// `previous_secret_expires_at` is in the future, deliveries carry two
  /// signatures so the customer can roll without dropping events.
  previousSecret          String?   @map("previous_secret") @db.VarChar(64)
  previousSecretExpiresAt DateTime? @map("previous_secret_expires_at") @db.Timestamptz

  isActive Boolean @default(true) @map("is_active")

  /// Why WE disabled it (auto-disable after sustained failure). Null for a
  /// tenant's own PATCH — the distinction the UI renders.
  disabledReason String? @map("disabled_reason") @db.VarChar(500)

  /// Consecutive terminal failures, reset on any delivered event. At
  /// `WEBHOOK_DISABLE_AFTER_FAILURES` the endpoint is disabled, the reason
  /// written, and the tenant told at HIGH priority.
  consecutiveFailures Int @default(0) @map("consecutive_failures")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  deliveries WebhookDelivery[]

  /// Every dispatch asks "which of this tenant's ACTIVE endpoints subscribe to
  /// this type" — tenant-first, like every hot-path index in this schema.
  @@index([organizationId, isActive])
  @@map("webhook_endpoints")
}

/// One EVENT delivered (or not) to one endpoint.
///
/// Anchored to the event, not to a notification: one POST per event however
/// many people the notification reached, so a row here is a fact about the
/// integration rather than about any recipient. Pruned by `webhook-retention`
/// after `WEBHOOK_RETENTION_DAYS` — one row per event per endpoint is unbounded
/// in a way `notification_deliveries` never was.
model WebhookDelivery {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  endpointId String @map("endpoint_id") @db.Uuid

  /// The payload `id` the receiver deduplicates on. **Fixed at enqueue**, so
  /// five retries of one event send one id five times — the property the
  /// customer's idempotency depends on.
  eventId String @map("event_id") @db.Uuid

  /// `NotificationType` — the public vocabulary, matching the payload's `type`.
  eventType String @map("event_type") @db.VarChar(100)

  /// The `WebhookEventPayload`, stored at enqueue. The row is the source of
  /// truth for every retry — the queue job carries only this row's id — and
  /// storing it is also what lets `.../test` and a support thread see exactly
  /// what a receiver was sent. Serialization to bytes happens once, in the
  /// sender, so signing and sending still share one string.
  payload Json @db.JsonB

  /// WebhookDeliveryStatus. PENDING until the receiver answers 2xx
  /// (DELIVERED) or every attempt is exhausted (FAILED).
  status String @default("PENDING") @db.VarChar(20)

  attempts Int @default(0)

  /// The receiver's last HTTP status — the field that makes
  /// `GET .../deliveries` a debugging surface rather than a mystery.
  responseStatus Int?    @map("response_status")
  lastError      String? @map("last_error") @db.VarChar(500)

  /// When the EVENT occurred — the payload's `occurredAt`, not this attempt.
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  /// One row per event per endpoint — the retry updates its row rather than
  /// appending, so "was this event delivered" has one answer.
  @@unique([endpointId, eventId])
  /// The debugging surface reads most-recent-first per endpoint; retention
  /// sweeps by age.
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("webhook_deliveries")
}
