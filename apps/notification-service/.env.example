# notification-service — every variable it reads, in the shared section order.
# Copy to `.env` and fill in real values; names and placeholders only here.

# ---------------------------------------------------------------- 1 RUNTIME

NODE_ENV = development
LOG_LEVEL = log

# The gRPC server for the feed API. 5005 continues the auth=5001,
# ticket=5002, ingestion=5004 sequence.
GRPC_HOST = 0.0.0.0
GRPC_PORT = 5005

# ---------------------------------------------------------------- 2 BUILD
# Injected by the image build (Dockerfile ARGs) — a container has no `.git`
# to ask at runtime. Local runs use stand-in values; missing values refuse to
# boot rather than report "unknown".

APP_VERSION = 0.0.0-local
BUILD_SHA = 0000000000000000000000000000000000000000
BUILD_TIME = 1970-01-01T00:00:00.000Z

# ---------------------------------------------------------------- 3 DATA

# Domain E's own database — added with in-app notifications.
DATABASE_URL = postgresql://user:password@localhost:5435/synapsedesk_notification?schema=public

# BullMQ: the scheduler queue and outbound webhook deliveries.
REDIS_URL = redis://localhost:6379

# ---------------------------------------------------------------- 4 MESSAGING

# Consumes every producer's notification subjects.
NATS_URL = nats://localhost:4222
# The NATS server's HTTP monitor, for JetStream health checks (ADR 0041).
NATS_MONITOR_URL = http://localhost:8222

# ---------------------------------------------------------------- 5 PEERS

# auth-service, for resolving a notification audience from a permission code.
AUTH_SERVICE_URL = localhost:5001

# ---------------------------------------------------------------- 6 AUTH & SECRETS

# Inbound email: builds the `Reply-To` on ticket notifications. The secret
# MUST match the gateway's — it verifies what this signs, and a mismatch
# makes every reply open a duplicate ticket instead of threading, with nothing
# in a log. Same value in api-gateway's `.env`; the placeholder below is
# byte-identical to the gateway's on purpose, so two different strings read as
# the bug they are.
INBOUND_EMAIL_SECRET = the-same-64-hex-secret-in-gateway-and-notification
INBOUND_EMAIL_DOMAIN = inbound.example.com

# ---------------------------------------------------------------- 7 THIRD PARTY

# Resend (https://resend.com/api-keys), outbound mail through its HTTP API. A
# SENDING-ONLY key is enough here, and a different key from the gateway's
# RESEND_GATEWAY_API_KEY: a leaked sending key must not read inbound mail.
RESEND_API_KEY = re_your_sending_only_key
# Our OWN sending address, on a domain VERIFIED in Resend — any other domain is
# refused with 403. (`onboarding@resend.dev` works unverified, but delivers only
# to the Resend account's own address.) MUST match the gateway's EMAIL_SENDER —
# its self-loop guard compares against it, and a mismatch fails OPEN into an
# unbounded mail loop.
EMAIL_SENDER = '"SynapseDesk" <noreply@example.com>'

# Twilio, for SMS (https://www.twilio.com). Optional: absent, the SMS channel
# reports itself unconfigured rather than the service refusing to boot.
# TWILIO_SID =
# TWILIO_AUTH_TOKEN =
# TWILIO_AUTH_PHONE =

# Firebase Cloud Messaging, for push. Path to a service-account JSON
# (Firebase console > Project settings > Service accounts); the file itself
# is gitignored. Optional: absent, push is reported unconfigured.
# FIREBASE_MESSAGING_SERVICE_ACCOUNT_PATH = ./serviceAccountKey.json

# ---------------------------------------------------------------- 8 POLICY

# Branding / links used in outbound messages.
APP_NAME = SynapseDesk
APP_WEB_URL = http://localhost:5173
SUPPORT_EMAIL = support@example.com

# ---------------------------------------------------------------- 9 DEVELOPMENT

# DISABLES the outbound-webhook SSRF guard so a localhost receiver can be
# tested. Honoured only when NODE_ENV=development — ignored everywhere else,
# so a copied .env cannot carry it into production. Never set it there anyway.
# WEBHOOK_ALLOW_PRIVATE_TARGETS = false
