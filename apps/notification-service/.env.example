# NATS
NATS_URL =

# Branding / links used in outbound messages
APP_NAME =
APP_WEB_URL =
SUPPORT_EMAIL =

# Nodemailer configuration (using Gmail SMTP server)
EMAIL_HOST =
EMAIL_PORT =
EMAIL_SECURE =
EMAIL_USER =
EMAIL_PASS =
EMAIL_SENDER =

# Twilio configuration (visit https://www.twilio.com/ to create a free account)
TWILIO_SID =
TWILIO_AUTH_TOKEN =
TWILIO_AUTH_PHONE =

# Node
NODE_ENV =
LOG_LEVEL =

# Domain E's own database — added with in-app notifications.
DATABASE_URL = postgresql://postgres:password123456789@localhost:5435/synapsedesk_notification?schema=public

# For resolving a notification audience from a permission code.
AUTH_SERVICE_URL = localhost:5001

# Applies the four partial indexes Prisma cannot express.
SEED_ON_BOOTSTRAP = true

# The gRPC server for the feed API. 5005 continues the
# auth=5001, ticket=5002, ingestion=5004 sequence.
GRPC_HOST = 0.0.0.0
GRPC_PORT = 5005

# --------------------------------------------------------------- inbound email
# Builds the `Reply-To` on ticket notifications. The secret MUST
# match the gateway's: it verifies what this signs, and a mismatch makes every
# reply open a duplicate ticket instead of threading.
INBOUND_EMAIL_SECRET = 
INBOUND_EMAIL_DOMAIN = 
