NODE_ENV = test
LOG_LEVEL = error

# NATS is not connected by this suite — it calls the service directly, which is
# the same discipline every other e2e layer here follows.
NATS_URL = nats://localhost:4222

APP_NAME = SynapseDesk
APP_WEB_URL = http://localhost:3000
# `.com`, not `.test`: Joi's `.email()` validates the TLD against the IANA
# list, and a reserved TLD fails it — a boot error that reads as a config bug
# rather than as a test-fixture choice.
SUPPORT_EMAIL = support@synapsedesk.com

# SMTP is never reached: the suite spies on `EmailService.send` and asserts on
# the CAPTURED command. A real transport would make the test depend on a mail
# server being up to prove that a notification was delivered.
EMAIL_HOST = localhost
EMAIL_PORT = 1025
EMAIL_SECURE = false
EMAIL_USER = test
EMAIL_PASS = test
EMAIL_SENDER = noreply@synapsedesk.com

# Domain E's TEST database, a sibling on the same container.
DATABASE_URL = postgresql://postgres:password123456789@localhost:5435/synapsedesk_notification_test?schema=public

# auth-service is not running for this suite; the audience resolver is spied on.
AUTH_SERVICE_URL = localhost:5001
