# Nestjs Server Config
PORT =
GLOBAL_PREFIX =
CORS =
NODE_ENV =

# JWT
JWT_ACCESS_NAME =
# Generated by `npm run keys:generate` at the repo root. Public half only — the
# gateway verifies tokens and can never mint them.
JWT_ACCESS_PUBLIC_KEY_PATH =

JWT_REFRESH_NAME =
JWT_2FA_PUBLIC_KEY_PATH =
JWT_2FA_NAME =

TENANT_SELECTION_NAME =
DEVICE_TOKEN_NAME =

# Cookie
COOKIE_ACCESS_MAX_AGE =
COOKIE_REFRESH_MAX_AGE =
COOKIE_2FA_MAX_AGE =

# 30 days, matching auth-service TRUSTED_DEVICE_TTL_DAYS
COOKIE_DEVICE_MAX_AGE =
# 5 minutes, matching auth-service JWT_TENANT_SELECTION_EXPIRES_IN
COOKIE_TENANT_SELECTION_MAX_AGE =

COOKIE_SAMESITE =

# gRPC
AUTH_SERVICE_URL =

# --- Rate limiting ---------------------------------------------------------
# Counters live in Redis so a limit is a property of the SYSTEM, not of one
# replica. TTLs are milliseconds.
REDIS_URL = redis://localhost:6379

# General backstop for ordinary routes.
THROTTLER_SHORT_TTL = 1000
THROTTLER_SHORT_LIMIT = 30
THROTTLER_MEDIUM_TTL = 10000
THROTTLER_MEDIUM_LIMIT = 150
THROTTLER_LONG_TTL = 60000
THROTTLER_LONG_LIMIT = 600

# Strict tier, applied ONLY to routes marked @AuthThrottle(). Individual routes
# tighten it further via @Throttle() — see ROUTE_THROTTLE in app.config.ts.
THROTTLER_AUTH_TTL = 900000
THROTTLER_AUTH_LIMIT = 30

# Domain E, added with the feed API (18-doc §1.1).
NOTIFICATION_SERVICE_URL = localhost:5005

# ------------------------------------------------------------------ inbound email
# 31-doc §6. The gateway is the email adapter: it verifies the Worker's HMAC,
# parses the recipient address, and runs the mail-loop guards.
# EMAIL_SENDER must match notification-service's — the self-loop guard compares
# against it, and a mismatch fails OPEN into an unbounded loop.
INBOUND_EMAIL_SECRET = 
INBOUND_EMAIL_DOMAIN = 
EMAIL_SENDER = 
