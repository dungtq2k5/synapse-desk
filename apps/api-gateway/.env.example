# api-gateway — every variable it reads, in the shared section order.
# Copy to `.env` and fill in real values; names and placeholders only here.

# ---------------------------------------------------------------- 1 RUNTIME

NODE_ENV = development
PORT = 3000
GLOBAL_PREFIX = api

# Comma-separated browser origins the API answers for.
CORS = http://localhost:5173,http://localhost:3000

# `/docs` and `/docs-json`. Defaults to FALSE, so an environment that never
# considered the question is closed rather than open — and config rather than
# an inline NODE_ENV check, because that check is the one a refactor inverts
# and nobody notices: the failure direction is more exposure, and more
# exposure looks like everything working. MUST be false in production.
# SWAGGER_ENABLED = false

# `/metrics`, on its OWN listener — a distinct port is what makes "not
# reachable from the internet" structural rather than an Nginx rule. Host
# defaults to loopback; a Kubernetes pod sets 0.0.0.0 for the scraper.
METRICS_PORT = 9464
# METRICS_HOST = 127.0.0.1

# ---------------------------------------------------------------- 2 BUILD
# Injected by the image build (Dockerfile ARGs) — a container has no `.git`
# to ask at runtime. Local runs use stand-in values; missing values refuse to
# boot rather than report "unknown".

APP_VERSION = 0.0.0-local
BUILD_SHA = 0000000000000000000000000000000000000000
BUILD_TIME = 1970-01-01T00:00:00.000Z

# ---------------------------------------------------------------- 3 DATA

# Rate-limit counters live in Redis rather than in-process memory: with the
# in-memory default every replica keeps its own tally, so a 5-per-15-minutes
# login limit silently becomes 5 x N.
REDIS_URL = redis://localhost:6379

# ---------------------------------------------------------------- 4 MESSAGING

# The gateway is a hybrid app: HTTP for clients, and a NATS CONSUMER for the
# domain events it relays to WebSocket rooms. It publishes nothing.
NATS_URL = nats://localhost:4222

# ---------------------------------------------------------------- 5 PEERS
# The gRPC addresses of every service the gateway calls. All required: a
# gateway that boots without one answers 500 on that surface with an error
# naming no cause, which is worse than refusing to boot where the
# misconfiguration is.

AUTH_SERVICE_URL = localhost:5001
TICKET_SERVICE_URL = localhost:5002
INGESTION_SERVICE_URL = localhost:5004
NOTIFICATION_SERVICE_URL = localhost:5005
# rag-service — the one Python peer.
RAG_SERVICE_URL = localhost:50255

# ---------------------------------------------------------------- 6 AUTH & SECRETS

# Cookie names for the token pairs. The gateway holds no signing material of
# any kind — it verifies, never mints; the *_PUBLIC_KEY_PATH files are the
# public halves, generated by `npm run keys:generate` at the repo root.
JWT_ACCESS_NAME = access_token
JWT_ACCESS_PUBLIC_KEY_PATH = ./secrets/jwt-access.pub
JWT_REFRESH_NAME = refresh_token
# Separate 2FA pair, so a challenge token cannot verify where an access token
# is expected and vice versa.
JWT_2FA_NAME = mfa_token
JWT_2FA_PUBLIC_KEY_PATH = ./secrets/jwt-2fa.pub
# Short-lived token carrying a multi-tenant login between its two legs.
TENANT_SELECTION_NAME = sd_tenant_selection
# Opaque "remember this device" secret — never verified, only looked up.
DEVICE_TOKEN_NAME = sd_device_token

# Cookie lifetimes, milliseconds. Access/refresh/2FA run one second past
# their token's lifetime; device matches auth-service's
# TRUSTED_DEVICE_TTL_DAYS, tenant-selection matches its
# JWT_TENANT_SELECTION_EXPIRES_IN.
COOKIE_ACCESS_MAX_AGE = 901000
COOKIE_REFRESH_MAX_AGE = 10081000
COOKIE_2FA_MAX_AGE = 301000
COOKIE_DEVICE_MAX_AGE = 2592000000
COOKIE_TENANT_SELECTION_MAX_AGE = 300000
COOKIE_SAMESITE = lax

# Inbound email — the gateway is the email adapter: it verifies Resend's
# webhook signature, fetches the mail from Resend, parses the recipient address,
# and runs the mail-loop guards.
#
# **ONE value, TWO readers, and this placeholder is deliberately identical in
# both.** notification-service MINTS the per-ticket reply token into
# `Reply-To`, and the gateway parses it back out. A mismatch is silent:
# `parseTicketReplyToken` returns `null` and every reply opens a NEW ticket,
# with nothing in a log. Copy the same generated value into both — a partial
# rotation is worse than a wrong one, because half of it keeps working.
INBOUND_EMAIL_SECRET = the-same-64-hex-secret-in-gateway-and-notification
# The signing secret of the Resend `email.received` webhook (Standard Webhooks,
# `whsec_…`). `npm run resend:provision -- --apply` creates the webhook and
# prints it; `webhooks.get` reads it back later.
RESEND_WEBHOOK_SECRET = whsec_your_webhook_signing_secret
# The gateway's OWN Resend key, used to fetch an inbound mail's body and headers
# (`emails.receiving.get`) — not a sending endpoint, so a sending-only key is
# refused. A DIFFERENT key from notification-service's RESEND_API_KEY.
RESEND_GATEWAY_API_KEY = re_your_receiving_key
# The mail domain the catch-all route serves, for building Reply-To.
INBOUND_EMAIL_DOMAIN = inbound.example.com
# Our OWN sending address — the self-loop guard's whole basis. MUST match
# notification-service's EMAIL_SENDER: mail from it is ignored
# unconditionally, which is what stops a notification bouncing off an
# auto-responder forever. A mismatch fails OPEN into exactly that loop.
EMAIL_SENDER = '"SynapseDesk" <noreply@example.com>'

# ---------------------------------------------------------------- 8 POLICY

# Rate limiting, four tiers. short/medium/long are the general backstop for
# ordinary routes; auth is the strict tier applied ONLY to routes marked
# @AuthThrottle() (individual routes tighten further via ROUTE_THROTTLE in
# app.config.ts). TTLs are milliseconds.
THROTTLER_SHORT_TTL = 1000
THROTTLER_SHORT_LIMIT = 30
THROTTLER_MEDIUM_TTL = 10000
THROTTLER_MEDIUM_LIMIT = 150
THROTTLER_LONG_TTL = 60000
THROTTLER_LONG_LIMIT = 600
THROTTLER_AUTH_TTL = 900000
THROTTLER_AUTH_LIMIT = 30

# WebSocket handshake flood control — separate numbers from the HTTP tiers
# because they meter a different thing: opening a connection, not making a
# request. Sized generously; a browser reconnects on every network blip, and
# exhausting this costs a retry rather than a lockout.
WS_HANDSHAKE_LIMIT = 30
WS_HANDSHAKE_TTL = 60000
WS_HANDSHAKE_BLOCK_DURATION = 300000
