# E2E-test environment for the gateway. Loaded by `npm run test:e2e` via
# dotenv-cli, which runs from the REPO ROOT — every relative path below is
# therefore repo-root-relative, not service-relative like the ones in `.env`.
#
# The gateway owns no database, so there is no DATABASE_URL to redirect. What
# this file changes versus `.env` is exactly three things:
#   1. the JWT public key paths, pointed at the committed TEST keypair so the
#      suite can mint its own valid cookies (see test/utils/tokens.ts);
#   2. the Redis DB INDEX, so throttler counters cannot collide with a running
#      dev gateway's — the same limit, a different keyspace;
#   3. NODE_ENV=test.
# Everything else is copied verbatim on purpose: `envValidationSchema` runs
# regardless of NODE_ENV, so a missing var fails the suite at boot, and a suite
# running against different cookie names than production proves nothing.

PORT = 3100
GLOBAL_PREFIX = api
# The ACTUAL dev origins, not `*`.
#
# `*` is unusable here rather than permissive: every request is credentialed
# (the access token is an HttpOnly cookie) and the spec forbids
# `Access-Control-Allow-Origin: *` on a credentialed request. It also read two
# ways — the HTTP side refused everything, the socket side allowed everything.
#
# Comma-separated, and the parser trims: a space after a comma used to produce
# an origin that worked over HTTP and was refused over WebSocket.
CORS = http://localhost:5173,http://localhost:3000
NODE_ENV = test

# --- JWT ---
# The TEST keypair, committed under test/fixtures/keys. Its private half is
# loaded directly by test/utils/tokens.ts to sign fixtures; no running service
# ever sees it. Reusing the real dev pair here would mean a test-minted token
# is accepted by the dev gateway, which is exactly the property to avoid.
JWT_ACCESS_NAME = access_token
JWT_ACCESS_PUBLIC_KEY_PATH = ./apps/api-gateway/test/fixtures/keys/jwt-access.test.pub

JWT_REFRESH_NAME = refresh_token

JWT_2FA_NAME = mfa_token
JWT_2FA_PUBLIC_KEY_PATH = ./apps/api-gateway/test/fixtures/keys/jwt-2fa.test.pub

TENANT_SELECTION_NAME = sd_tenant_selection
DEVICE_TOKEN_NAME = sd_device_token

# --- Cookies ---
COOKIE_ACCESS_MAX_AGE = 901000
COOKIE_REFRESH_MAX_AGE = 10081000
COOKIE_2FA_MAX_AGE = 301000
COOKIE_DEVICE_MAX_AGE = 2592000000
COOKIE_TENANT_SELECTION_MAX_AGE = 300000
COOKIE_SAMESITE = lax

# --- gRPC ---
# Never dialled: every e2e test overrides AUTH_GRPC_CLIENT with a stub. The var
# is still required by the Joi schema, and a bogus port makes an accidental real
# call fail fast and loudly rather than hit a dev service.
AUTH_SERVICE_URL = localhost:59999

# --- Rate limiting ---
# Database 15 on the same Redis container. A separate INDEX rather than a
# separate container: the throttler suite needs the real Redis-backed storage
# (an in-memory stub would not prove keying works at all), but it must not
# consume a developer's own login budget, and `flushdb` in a fixture must not
# wipe a running gateway's counters.
REDIS_URL = redis://localhost:6379/15

# Tiers deliberately LOOSE for the general case: most e2e tests care about a
# route's own behaviour, and a suite that 429s halfway through reports a
# throttling bug in whichever test happened to run 31st. The throttler's own
# suite tightens these per-test via its own module override.
THROTTLER_SHORT_TTL = 1000
THROTTLER_SHORT_LIMIT = 10000
THROTTLER_MEDIUM_TTL = 10000
THROTTLER_MEDIUM_LIMIT = 10000
THROTTLER_LONG_TTL = 60000
THROTTLER_LONG_LIMIT = 10000
THROTTLER_AUTH_TTL = 900000
THROTTLER_AUTH_LIMIT = 10000

# --- gRPC: Domain B -------------------------------------------------------
# Never dialled: every e2e test overrides TICKET_GRPC_CLIENT with a stub. A
# bogus port makes an accidental real call fail fast rather than hit a dev peer.
TICKET_SERVICE_URL = localhost:59998

# --- NATS -----------------------------------------------------------------
# The gateway CONSUMES ticket.* domain events and relays them to WebSocket
# rooms. It publishes nothing.
NATS_URL = nats://localhost:4222

# --- WebSocket handshake flood control ------------------------------------
# Counted per IP in the same Redis-backed ThrottlerStorage the HTTP tiers use.
# Per IP rather than per account because at handshake time nothing is verified
# yet — the cookie is an unvalidated string, so identity is not yet a thing that
# can be keyed on.
# High enough that a suite opening many sockets in a row is not throttled by
# its own setup — the throttler has its own suite for the limit itself.
WS_HANDSHAKE_LIMIT = 10000
WS_HANDSHAKE_TTL = 60000
WS_HANDSHAKE_BLOCK_DURATION = 300000

# ingestion-service. Unroutable in tests: every RPC is stubbed at the DI
# boundary, and a REAL port here would let a missed stub quietly reach a live
# service instead of failing.
INGESTION_SERVICE_URL = localhost:59997

# rag-service — the one Python peer.
RAG_SERVICE_URL = localhost:59996

# Never dialled: every e2e test overrides NOTIFICATION_GRPC_CLIENT with a
# stub. The var must exist because env validation is strict.
NOTIFICATION_SERVICE_URL = localhost:59995

# Which build is this? Baked by the image build; these local
# values stand in for the ARGs a Dockerfile injects.
APP_VERSION = 0.0.0-local
BUILD_SHA = 0000000000000000000000000000000000000000
BUILD_TIME = 1970-01-01T00:00:00.000Z

# `/metrics`, on its own internal listener.
METRICS_PORT = 9464
METRICS_HOST = 127.0.0.1

# `/docs` and `/docs-json`. PUBLIC in non-prod; must be false in
# production, and the default is false so an unconsidered environment is closed.
SWAGGER_ENABLED = true

# ------------------------------------------------------------------ inbound email
# The gateway is the email adapter: it verifies the Worker's HMAC,
# parses the recipient address, and runs the mail-loop guards.
# EMAIL_SENDER must match notification-service's — the self-loop guard compares
# against it, and a mismatch fails OPEN into an unbounded loop.
INBOUND_EMAIL_SECRET = test-inbound-secret
INBOUND_EMAIL_DOMAIN = inbound.test
EMAIL_SENDER = support@synapsedesk.test
