# storage-service — every variable it reads, in the shared section order.
# Copy to `.env` and fill in real values; names and placeholders only here.
#
# storage-service has NO DATABASE_URL: its only state is a few-minutes-lived
# PendingUpload in Redis, whose TTL is its own cleanup.

# ---------------------------------------------------------------- 1 RUNTIME

NODE_ENV = development

# The gRPC server the owning services (ticket, auth) call.
GRPC_HOST = 0.0.0.0
GRPC_PORT = 50253

# ---------------------------------------------------------------- 2 BUILD
# Injected by the image build (Dockerfile ARGs) — a container has no `.git`
# to ask at runtime. Local runs use stand-in values; missing values refuse to
# boot rather than report "unknown".

APP_VERSION = 0.0.0-local
BUILD_SHA = 0000000000000000000000000000000000000000
BUILD_TIME = 1970-01-01T00:00:00.000Z

# ---------------------------------------------------------------- 3 DATA

# Where PendingUpload records live, with the TTL as their cleanup mechanism.
REDIS_URL = redis://localhost:6379
# A distinct db index per environment, so a test run cannot collide with dev
# data in the same Redis instance. Optional; defaults to 0.
# REDIS_DB = 0

# ---------------------------------------------------------------- 4 MESSAGING

# Consumes `storage.object.superseded`; publish-only services can skip NATS,
# this one cannot.
NATS_URL = nats://localhost:4222

# ---------------------------------------------------------------- 7 THIRD PARTY

# A SEPARATE service account from auth-service's: that one is scoped to
# Firebase Auth with no Storage grant, this one the reverse. Obtain from the
# Firebase console (Project settings → Service accounts) and save the JSON
# beside this file. SERVICE-relative path: `npm run dev` runs each service
# from its own directory.
FIREBASE_STORAGE_SERVICE_ACCOUNT_PATH = ./serviceAccountKey.json
FIREBASE_STORAGE_BUCKET = your-project.appspot.com

# ---------------------------------------------------------------- 8 POLICY

# How long a signed upload URL — and its PendingUpload — lives.
UPLOAD_URL_TTL_SECONDS = 600
# How long a signed READ url lives. Short on purpose: revoking access takes
# effect on the next issuance, so this TTL is how long a revoked user keeps
# reading.
READ_URL_TTL_SECONDS = 900

# ---------------------------------------------------------------- 9 DEVELOPMENT

# The Storage EMULATOR, dev and test only — leave unset in production. Read
# by firebase-admin itself (not by this service's code); `host:port`, no
# scheme. One variable is enough: firebase-admin 14 translates it down to the
# @google-cloud/storage layer, measured against the emulator suite.
# FIREBASE_STORAGE_EMULATOR_HOST = localhost:9199
