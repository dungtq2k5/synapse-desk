# E2E-test environment. Loaded by `npm run test:e2e:storage` via dotenv-cli,
# which runs from the REPO ROOT — so every relative path below is repo-root
# relative.
#
# storage-service has NO DATABASE_URL: its only state is a few-minutes-lived
# PendingUpload in Redis, whose TTL is its own cleanup (§1.2).

NODE_ENV = test

# The Storage EMULATOR, never a real bucket (§1.7). Same principle as "never
# point tests at the dev database", applied to cloud infra: a suite that
# deletes objects would otherwise delete real customer files.
STORAGE_EMULATOR_HOST = http://localhost:9199
FIREBASE_STORAGE_EMULATOR_HOST = localhost:9199
FIREBASE_STORAGE_BUCKET = synapsedesk-test.appspot.com
FIREBASE_STORAGE_SERVICE_ACCOUNT_PATH = apps/storage-service/serviceAccountKey.json

# A DISTINCT Redis index, so a suite's flush cannot take dev data with it.
REDIS_URL = redis://localhost:6379
REDIS_DB = 3

GRPC_HOST = 0.0.0.0
GRPC_PORT = 50253

NATS_URL = nats://localhost:4222

# Short TTLs so the expiry tests do not have to wait ten minutes.
UPLOAD_URL_TTL_SECONDS = 600
READ_URL_TTL_SECONDS = 900

# Which build is this? — 23-doc §3. Baked by the image build; these local
# values stand in for the ARGs the Dockerfile injects.
APP_VERSION = 0.0.0-local
BUILD_SHA = 0000000000000000000000000000000000000000
BUILD_TIME = 1970-01-01T00:00:00.000Z
