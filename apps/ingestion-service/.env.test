NODE_ENV = test

# Domain C's OWN database — a different physical Postgres again. The separation
# is why `created_by_id` and `department_id` carry no foreign key.
DATABASE_URL = postgresql://postgres:password123456789@localhost:5434/synapsedesk_ingestion_test?schema=public

# Publishes document.* and consumes nothing initially.
NATS_URL = nats://localhost:4222

# The gRPC server the gateway calls.
GRPC_HOST = 0.0.0.0
GRPC_PORT = 50254

# auth-service, for write-time validation of created_by_id / department_id and
# for reading the tenant's storage quota before signing an upload.
AUTH_SERVICE_URL = localhost:5001

# storage-service, for the DOCUMENT purpose.
STORAGE_SERVICE_URL = localhost:50253

# Applies the partial and composite indexes on boot. False in .env.test, where
# the fixture calls the seeder explicitly.
SEED_ON_BOOTSTRAP = false

# How long a download URL is advertised as valid, in seconds. MUST stay strictly
# below storage-service's READ_URL_TTL_SECONDS (900) — that service owns the
# URL's real lifetime and this is only what the client is told, so a client
# refreshing on expiry does it just before the URL dies rather than just after.
DOWNLOAD_URL_TTL_SECONDS = 840

# BullMQ's queue and, from step 2, the AI quota counter.
REDIS_URL = redis://localhost:6379

# A distinct Redis index for the test run.
REDIS_DB = 4

# The vector store. The SAME instance rag-service's suite uses — deliberately:
# the two services must agree about one collection, and pointing them at
# separate Qdrants in tests would hide exactly the disagreement that matters.
QDRANT_URL = http://localhost:6333

# Absent on purpose. The ingestion suite overrides EMBEDDING_CLIENT with a
# substitute (§2.6), so the pipeline runs with no API key, no network and no
# per-run spend — while still exercising real batching, real ledger writes and
# real Qdrant upserts.

# Which build is this? — 23-doc §3. Baked by the image build; these local
# values stand in for the ARGs the Dockerfile injects.
APP_VERSION = 0.0.0-local
BUILD_SHA = 0000000000000000000000000000000000000000
BUILD_TIME = 1970-01-01T00:00:00.000Z
