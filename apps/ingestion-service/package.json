    "@synapsedesk/common": "*",
    "@synapsedesk/grpc-proto": "*",
    "bullmq": "^5.81.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.3",
    "js-tiktoken": "^1.0.21",
    "mammoth": "^1.12.0",
    "nats": "^2.29.3",
    "pdfjs-dist": "^5.7.284",
