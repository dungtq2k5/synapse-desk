dist/
node_modules/
docs/
cspell.json
.env
*.tsbuildinfo
.claude/
coverage/

# Turborepo per-package task logs and local cache. One appears in every
# workspace the moment a turbo task runs, and the contents are machine-specific.
.turbo/

# Python. `apps/rag-service/.gitignore` already covers its own subtree; these
# are here so the next Python thing added anywhere else starts out ignored
# rather than being discovered later, after `git add -A` has staged it.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Prisma client output — rebuilt by `prisma generate` (wired to postinstall).
# Deliberately narrow: libs/grpc-proto/src/generated IS committed.
**/src/generated/prisma/

# Credentials — never commit. Regenerate keys with scripts/generate-jwt-keys.mjs
secrets/
*.key
*.pem
**/serviceAccountKey.json

# EXCEPTION: the test-only JWT keypair. It signs fixtures inside the e2e suite
# and nothing else — no running service ever loads it, and .env.test points the
# gateway's PUBLIC key paths here rather than at secrets/. It is committed on
# purpose: without it, a fresh clone cannot run `npm run test:e2e`, and the
# alternative (generate-on-first-run) means the suite silently passes against
# whatever key happens to be lying around.
!apps/api-gateway/test/fixtures/keys/*.key

# Firebase emulator: docker-compose mounts `docker/firebase` as the container's
# HOME (`/home/node`), so the emulator writes its own home-directory junk there.
# NOT the whole folder — `firebase.json`, `.firebaserc` and `storage.rules` are
# the emulator's CONFIG and a fresh clone cannot start it without them.
#
# `.config/` matters beyond the noise: it is where `firebase-tools` keeps its
# configstore, and a `firebase login` against this mount would write a refresh
# token straight into a tracked file.
docker/firebase/.cache/
docker/firebase/.config/
docker/firebase/*.log

# Compiler output that lands in src/ when a tsconfig is misconfigured (an
# outDir/rootDir mismatch emits .js and .d.ts beside the .ts they came from).
# Ignored rather than merely deleted because eslint's type-aware rules fail on
# a stray .d.ts with a parsing error that names the file but not the cause.
libs/*/src/**/*.js
libs/*/src/**/*.js.map
libs/*/src/**/*.d.ts