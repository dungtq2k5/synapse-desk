.vscode/
dist/
node_modules/
docs/archive
cspell.json
.env
# A developer's REAL test credentials — the only place a real secret may live,
# since `.env.test` is tracked. Loaded FIRST by the test:e2e:* scripts (dotenv
# never overwrites, so first wins); absent by default and silently skipped.
.env.test.local
# Generated per-service container env — `scripts/generate-docker-env.mjs`
# rewrites `.env`'s host addresses to compose service names. Generated, never
# tracked: a tracked copy would be a third hand-maintained value-set outside
# the env-contract guard's completeness checks.
.env.docker
*.tsbuildinfo
.claude/
coverage/

# CI run artifacts. `pytest.xml` is the JUnit report the python job hands to
# `scripts/check-pytest-skips.mjs`; `ci-artifacts/` is where the e2e job's
# failure capture lands before upload. Both are per-run output, and both are
# written by commands a developer can also run locally.
pytest.xml
ci-artifacts/

# Turborepo per-package task logs and local cache. One appears in every
# workspace the moment a turbo task runs, and the contents are machine-specific.
.turbo/

# Python. `apps/rag-service/.gitignore` already covers its own subtree; these
# are here so the next Python thing added anywhere else starts out ignored
# rather than being discovered later.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Prisma generated folders based on `schema.prisma` if each service uses prisma client
**/src/generated/prisma/

# Credentials (regenerate keys with `scripts/generate-jwt-keys.mjs`)
secrets/
*.key
*.pem
**/serviceAccountKey.json

# EXCEPTION: the test-only JWT keypair. It signs fixtures inside the e2e suite
# and nothing else — no running service ever loads it, and `.env.test` points the
# gateway's PUBLIC key paths here rather than at `secrets/`. It is committed on
# purpose: without it, a fresh clone cannot run `npm run test:e2e`, and the
# alternative (generate-on-first-run) means the suite silently passes against
# whatever key happens to be lying around.
!apps/api-gateway/test/fixtures/keys/*.key

# Firebase emulator: docker-compose mounts `docker/firebase` as the container's
# HOME (`/home/node`), so the emulator writes its own home-directory junk there.
docker/firebase/.cache/
docker/firebase/.config/
docker/firebase/*.log

# Compiler output that lands in `src/` when a tsconfig is misconfigured (an
# `outDir`/`rootDir` mismatch emits `.js` and `.d.ts` beside the `.ts` they came from).
# Ignored rather than merely deleted because eslint's type-aware rules fail on
# a stray `.d.ts` with a parsing error that names the file but not the cause.
libs/*/src/**/*.js
libs/*/src/**/*.js.map
libs/*/src/**/*.d.ts

# Derived: the demo seeder's manifest. A committed one goes stale the first
# time somebody reseeds, and a stale manifest names ids that no longer exist.
.demo-seed/
