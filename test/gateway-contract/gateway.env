# The environment the contract harness starts EITHER gateway with.
#
# The harness's own file, not a gateway's: the same values start the Node and
# the Java implementation, so a row's result cannot depend on which one's test
# env it borrowed. `gateway.ts` ASSIGNS these over `process.env`, and then its
# own per-launch values over these: the ports, the peer URLs (fake gRPC
# servers it starts), and REDIS_URL / NATS_URL (its own containers). A value
# below that the harness overrides is still here because both gateways refuse
# to start without it.
#
# Relative paths are repo-root-relative: the harness starts each gateway with
# the repository root as its working directory.
#
# Cookie names and the API prefix are production's own: rows that pass against
# names production does not use prove nothing.

PORT = 3100
WS_PORT = 3101
GLOBAL_PREFIX = api
# The real dev origins, not `*`: every request is credentialed, and the spec
# forbids `Access-Control-Allow-Origin: *` on a credentialed request.
CORS = http://localhost:5173,http://localhost:3000
NODE_ENV = test

# --- JWT ---
# The committed TEST keypair; the harness signs its fixtures with the private
# half (`peers.ts`), so no real key is ever involved.
JWT_ACCESS_NAME = access_token
JWT_ACCESS_PUBLIC_KEY_PATH = ./test/fixtures/keys/jwt-access.test.pub

JWT_REFRESH_NAME = refresh_token

JWT_2FA_NAME = mfa_token
JWT_2FA_PUBLIC_KEY_PATH = ./test/fixtures/keys/jwt-2fa.test.pub

TENANT_SELECTION_NAME = sd_tenant_selection
DEVICE_TOKEN_NAME = sd_device_token

# --- Cookies ---
COOKIE_ACCESS_MAX_AGE = 901000
COOKIE_REFRESH_MAX_AGE = 604801000
COOKIE_2FA_MAX_AGE = 301000
COOKIE_DEVICE_MAX_AGE = 2592000000
COOKIE_TENANT_SELECTION_MAX_AGE = 300000
COOKIE_SAMESITE = lax

# --- Peers: overridden per launch with the fake peers' addresses ---
# Unroutable here, so a launch that forgot one fails loudly instead of
# reaching a developer's running service.
AUTH_SERVICE_URL = localhost:59999
TICKET_SERVICE_URL = localhost:59998
INGESTION_SERVICE_URL = localhost:59997
RAG_SERVICE_URL = localhost:59996
NOTIFICATION_SERVICE_URL = localhost:59995

# --- Stores: overridden per launch with the harness's own containers ---
REDIS_URL = redis://localhost:6379/15
NATS_URL = nats://localhost:4222

# --- Rate limiting ---
# Loose, so a suite does not 429 halfway through and report a throttling bug
# in whichever row ran next. The rows that test a limit use a route's own
# tighter one.
THROTTLER_SHORT_TTL = 1000
THROTTLER_SHORT_LIMIT = 10000
THROTTLER_MEDIUM_TTL = 10000
THROTTLER_MEDIUM_LIMIT = 10000
THROTTLER_LONG_TTL = 60000
THROTTLER_LONG_LIMIT = 10000
THROTTLER_AUTH_TTL = 900000
THROTTLER_AUTH_LIMIT = 10000

WS_HANDSHAKE_LIMIT = 10000
WS_HANDSHAKE_TTL = 60000
WS_HANDSHAKE_BLOCK_DURATION = 300000

# --- Build identity: what an image build would inject ---
APP_VERSION = 0.0.0-local
BUILD_SHA = 0000000000000000000000000000000000000000
BUILD_TIME = 1970-01-01T00:00:00.000Z

# `/metrics`, on its own internal listener; the port is overridden per launch.
METRICS_PORT = 9464
METRICS_HOST = 127.0.0.1

SWAGGER_ENABLED = true

# --- Inbound email ---
# EMAIL_SENDER is what the self-loop guard compares against. The webhook
# secret is a real Standard Webhooks shape, because the rows sign with it.
INBOUND_EMAIL_SECRET = test-inbound-secret
RESEND_WEBHOOK_SECRET = whsec_c3luYXBzZWRlc2stZTJlLXdlYmhvb2stc2VjcmV0LSE=
RESEND_GATEWAY_API_KEY = re_test_placeholder
INBOUND_EMAIL_DOMAIN = inbound.test
EMAIL_SENDER = support@synapsedesk.test
