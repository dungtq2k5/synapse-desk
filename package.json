{
  "name": "synapsedesk",
  "private": true,
  "packageManager": "npm@11.9.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "test": "jest --projects apps/*/jest.config.ts libs/*/jest.config.ts --passWithNoTests",
    "test:all": "jest --projects apps/*/jest.config.ts libs/*/jest.config.ts --passWithNoTests",
    "test:auth": "jest --config apps/auth-service/jest.config.ts --passWithNoTests",
    "test:watch": "jest --projects apps/*/jest.config.ts libs/*/jest.config.ts --watch --passWithNoTests",
    "test:e2e:auth": "npm run db:test:push && dotenv -e apps/auth-service/.env.test -- jest --config apps/auth-service/jest.e2e.config.ts --runInBand",
    "test:e2e:gateway": "dotenv -e apps/api-gateway/.env.test -- jest --config apps/api-gateway/jest.e2e.config.ts --runInBand",
    "test:e2e:ticket": "dotenv -e apps/ticket-service/.env.test -- jest --config apps/ticket-service/jest.e2e.config.ts --runInBand",
    "test:e2e:storage": "dotenv -e apps/storage-service/.env.test -- jest --config apps/storage-service/jest.e2e.config.ts --runInBand",
    "test:e2e": "npm run test:e2e:auth && npm run test:e2e:ticket && npm run test:e2e:storage && npm run test:e2e:gateway",
    "test:cov": "jest --projects apps/*/jest.config.ts libs/*/jest.config.ts --coverage --passWithNoTests",
    "db:push": "npm run -w @synapsedesk/auth-service db:push",
    "db:test:push": "npm run -w @synapsedesk/auth-service db:push -- --url \"$(grep '^DATABASE_URL' apps/auth-service/.env.test | cut -d= -f2- | tr -d ' ')\"",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"{apps,libs,scripts}/**/*.{ts,mjs,json}\" \"*.{ts,mjs,json,yaml}\"",
    "format:check": "prettier --check \"{apps,libs,scripts}/**/*.{ts,mjs,json}\" \"*.{ts,mjs,json,yaml}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "clean": "turbo run clean",
    "clean:all": "turbo run clean && rimraf node_modules \"apps/*/node_modules\" \"libs/*/node_modules\" \".turbo\" \"apps/*/.turbo\" \"libs/*/.turbo\"",
    "keys:generate": "node scripts/generate-jwt-keys.mjs",
    "proto:generate": "npm run proto:generate -w @synapsedesk/grpc-proto",
    "proto:lint": "npm run proto:lint -w @synapsedesk/grpc-proto",
    "proto:breaking": "npm run proto:breaking -w @synapsedesk/grpc-proto"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
