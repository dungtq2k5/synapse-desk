{
  "name": "synapsedesk",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "npm@11.9.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "//overrides": "`@nestjs/apollo@13` requires `@apollo/server@^5` while depending on `@apollo/server-plugin-landing-page-graphql-playground@4`, which peers on `^4` \u2014 an internal conflict in the package, not in this repo. Pinning one Apollo server for the whole tree resolves it. The plugin is only reached when `playground: true`, which the GraphQL config turns off, so the version it never loads against is the version it never runs on.",
  "overrides": {
    "@apollo/server": "^5.5.1"
  },
  "scripts": {
    "test": "jest --projects apps/*/jest.config.ts libs/*/jest.config.ts scripts/jest.config.ts test/system/jest.unit.config.ts --passWithNoTests --runInBand",
    "test:all": "jest --projects apps/*/jest.config.ts libs/*/jest.config.ts scripts/jest.config.ts --passWithNoTests",
    "setup:py": "cd apps/rag-service && python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt -r requirements-dev.txt",
    "test:py": "cd apps/rag-service && .venv/bin/pytest -q",
    "test:py:watch": "cd apps/rag-service && .venv/bin/pytest -q -x --ff",
    "eval:rag": "cd apps/rag-service && .venv/bin/python eval/run.py",
    "test:gateway": "jest --config apps/api-gateway/jest.config.ts --passWithNoTests",
    "test:auth": "jest --config apps/auth-service/jest.config.ts --passWithNoTests",
    "test:watch": "jest --projects apps/*/jest.config.ts libs/*/jest.config.ts scripts/jest.config.ts --watch --passWithNoTests",
    "test:e2e:gateway": "dotenv -e apps/api-gateway/.env.test.local -e apps/api-gateway/.env.test -- jest --config apps/api-gateway/jest.e2e.config.ts --runInBand",
    "test:e2e:auth": "dotenv -e apps/auth-service/.env.test.local -e apps/auth-service/.env.test -- jest --config apps/auth-service/jest.e2e.config.ts --runInBand",
    "test:e2e:ticket": "dotenv -e apps/ticket-service/.env.test.local -e apps/ticket-service/.env.test -- jest --config apps/ticket-service/jest.e2e.config.ts --runInBand",
    "test:e2e:notification": "dotenv -e apps/notification-service/.env.test.local -e apps/notification-service/.env.test -- jest --config apps/notification-service/jest.e2e.config.ts --runInBand",
    "test:e2e:ingestion": "dotenv -e apps/ingestion-service/.env.test.local -e apps/ingestion-service/.env.test -- jest --config apps/ingestion-service/jest.e2e.config.ts --runInBand",
    "test:e2e:storage": "dotenv -e apps/storage-service/.env.test.local -e apps/storage-service/.env.test -- jest --config apps/storage-service/jest.e2e.config.ts --runInBand",
    "test:e2e": "npm run test:e2e:gateway && npm run test:e2e:auth && npm run test:e2e:ticket && npm run test:e2e:notification && npm run test:e2e:ingestion && npm run test:e2e:storage",
    "//test:system": "DESTRUCTIVE to three stores on every run, in setup AND teardown: flushes the entire dev Redis (BullMQ schedules, throttler counters, AI quota counters, socket channels, alert levels), drops the Qdrant collection, and resets the JetStream streams. Postgres alone is spared \u2014 wipe it first with `node scripts/reset-databases.mjs --dev-only`; seeding happens inside the run, after the stack is up, because both seeders depend on rows a service writes at boot.",
    "test:system": "jest --config test/system/jest.config.ts",
    "test:cov": "jest --projects apps/*/jest.config.ts libs/*/jest.config.ts scripts/jest.config.ts --coverage --passWithNoTests",
    "db:generate:auth": "npm run db:generate -w @synapsedesk/auth-service",
    "db:generate:ticket": "npm run db:generate -w @synapsedesk/ticket-service",
    "db:generate:notification": "npm run db:generate -w @synapsedesk/notification-service",
    "db:generate:ingestion": "npm run db:generate -w @synapsedesk/ingestion-service",
    "db:generate": "turbo run db:generate",
    "db:push:auth": "npm run db:push -w @synapsedesk/auth-service",
    "db:push:ticket": "npm run db:push -w @synapsedesk/ticket-service",
    "db:push:notification": "npm run db:push -w @synapsedesk/notification-service",
    "db:push:ingestion": "npm run db:push -w @synapsedesk/ingestion-service",
    "db:push": "npm run db:push --workspaces --if-present",
    "db:test:push:auth": "npm run db:test:push -w @synapsedesk/auth-service",
    "db:test:push:ticket": "npm run db:test:push -w @synapsedesk/ticket-service",
    "db:test:push:notification": "npm run db:test:push -w @synapsedesk/notification-service",
    "db:test:push:ingestion": "npm run db:test:push -w @synapsedesk/ingestion-service",
    "db:test:push": "npm run db:test:push --workspaces --if-present",
    "build": "turbo run build",
    "dev:py": "npm run dev -w @synapsedesk/rag-service",
    "dev": "turbo run dev",
    "//lint": "turbo lints WORKSPACES, and `scripts/seed-demo/` and `test/system/` are not workspaces \u2014 both were invisible to this command until the trailing eslint call, the same shape as the root tsconfig include gap. The loose `.mjs` scripts stay outside: they are plain JS no lint project parses, which is the status quo this line inherits rather than a decision it makes. `lint:md` is chained here rather than left as its own CI step so that a developer running `npm run lint` cannot pass locally and fail in CI on a doc \u2014 which is the whole failure a lint command exists to prevent. CI therefore has no separate markdown step; `npm run lint` is the one that runs it, and `ci-contract.spec.ts` REQUIRES that invocation.",
    "lint": "npm run lint:models && turbo run lint && eslint scripts/seed-demo test/system && npm run lint:md",
    "lint:md": "markdownlint-cli2",
    "lint:models": "node scripts/check-model-literals.mjs",
    "lint:fix": "turbo run lint -- --fix",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:py": "cd apps/rag-service && .venv/bin/ruff check rag_service tests scripts eval && .venv/bin/python scripts/check-imports.py",
    "lint:py:fix": "cd apps/rag-service && .venv/bin/ruff check rag_service tests scripts eval --fix",
    "format": "prettier --write \"{apps,libs,scripts,test,docker}/**/*.{ts,mjs,json}\" \"*.{ts,mjs,json,jsonc,yaml}\" \"docs/**/*.json\" \"k8s/**/*.yaml\"",
    "format:check": "prettier --check \"{apps,libs,scripts,test,docker}/**/*.{ts,mjs,json}\" \"*.{ts,mjs,json,jsonc,yaml}\" \"docs/**/*.json\" \"k8s/**/*.yaml\"",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "typecheck:py": "cd apps/rag-service && .venv/bin/pyrefly check",
    "clean": "turbo run clean",
    "clean:all": "turbo run clean && rimraf node_modules \"apps/*/node_modules\" \"libs/*/node_modules\" \".turbo\" \"apps/*/.turbo\" \"libs/*/.turbo\"",
    "keys:generate": "node scripts/generate-jwt-keys.mjs",
    "keys:service-account": "node scripts/generate-storage-emulator-key.mjs apps/storage-service/serviceAccountKey.json && node scripts/generate-storage-emulator-key.mjs apps/auth-service/serviceAccountKey.json",
    "nats:reset": "node scripts/reset-jetstream.mjs",
    "stripe:provision": "node scripts/provision-stripe.mjs",
    "stripe:provision:apply": "node scripts/provision-stripe.mjs --apply",
    "resend:provision": "node scripts/provision-resend.mjs",
    "resend:provision:apply": "node scripts/provision-resend.mjs --apply",
    "plans:seed": "node scripts/seed-plans.mjs",
    "plans:seed:apply": "node scripts/seed-plans.mjs --apply",
    "db:reset": "node scripts/reset-databases.mjs",
    "db:verify": "node scripts/verify-schema.mjs",
    "seed:demo": "tsx --tsconfig scripts/tsconfig.json scripts/seed-demo/index.ts",
    "seed:demo:apply": "tsx --tsconfig scripts/tsconfig.json scripts/seed-demo/index.ts --apply",
    "proto:generate": "npm run proto:generate -w @synapsedesk/grpc-proto",
    "proto:check": "npm run proto:check -w @synapsedesk/grpc-proto",
    "proto:lint": "npm run proto:lint -w @synapsedesk/grpc-proto",
    "proto:breaking": "npm run proto:breaking -w @synapsedesk/grpc-proto"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^24.13.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "markdownlint-cli2": "^0.23.2",
    "prisma-erd-generator": "^2.4.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
