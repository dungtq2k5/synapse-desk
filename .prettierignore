# Build output
dist/
node_modules/
*.tsbuildinfo

# Python virtualenvs. `node_modules`' opposite number: third-party code this
# repo neither authors nor formats. Without this, `format:check` fails on the
# JSON that ships inside installed packages (SBOMs, JSON Schemas).
**/.venv/

# Generated code — rewritten by `buf generate` / `prisma generate`, so
# formatting it only produces a diff that comes straight back on the next run.
# ESLint already skips these via the `**/generated/**` ignore in eslint.config.mjs.
**/generated/

# Lockfiles. npm owns their formatting and rewrites them wholesale on every
# install; prettier reformatting one produces a diff that comes straight back,
# and a `format:check` that fails after `npm i` teaches people to skip the
# gate. Excluded HERE rather than by shaping the glob around them, so the
# coverage check in `ci-contract.spec.ts` — which reads from the files toward
# the config — sees a deliberate exclusion instead of an uncovered file.
package-lock.json
**/package-lock.json

# Secrets and env
secrets/
*.key
*.pem
.env*
