# Root environment — read by `docker-compose.yml` ONLY.
#
# Every `${VAR}` in that file resolves from here, so a missing value is not a
# missing feature: compose substitutes an empty string, the postgres containers
# come up with no user, password or database, and the port mappings bind
# somewhere random. The failure surfaces as the e2e suites failing to connect,
# which reads like a test problem.
#
# Copy to `.env` (gitignored) before `npm run dev`, `npm run test:e2e` or
# anything that starts the stack: `cp .env.example .env`.
#
# **These are container credentials for a stack that listens on localhost**,
# and the same values already appear in every service's tracked `.env.test`.
# Changing them here means changing them there too — `ci-contract.spec.ts`
# asserts that every variable compose reads is documented in this file, and
# the service DATABASE_URLs are what pin the values themselves.

DB_USER = postgres
DB_PASSWORD = password123456789

# One postgres container per domain, each on its own host port, because the
# services own separate databases and cross-service ids carry no foreign key.
AUTH_DB_NAME = synapsedesk_auth
AUTH_DB_PORT = 5432

TICKET_DB_NAME = synapsedesk_ticket
TICKET_DB_PORT = 5433

INGESTION_DB_NAME = synapsedesk_ingestion
INGESTION_DB_PORT = 5434

NOTIFICATION_DB_NAME = synapsedesk_notification
NOTIFICATION_DB_PORT = 5435

REDIS_PORT = 6379

NATS_PORT = 4222
# The HTTP monitor, which NATS_MONITOR_URL and the JetStream healthcheck use.
NATS_DASHBOARD_PORT = 8222

QDRANT_PORT = 6333
QDRANT_GRPC_PORT = 6334

# Used ONLY by `scripts/provision-stripe.mjs`, which writes to a real Stripe
# sandbox — nothing in the test or dev boot path reads it. A restricted key
# (`rk_test_…`) from the Stripe dashboard, never a secret key.
STRIPE_RESTRICT_KEY = rk_test_...

# Also ONLY for `scripts/provision-stripe.mjs`: the public origin Stripe should
# POST webhooks to, plus the route. Nothing at runtime reads it — the gateway
# learns its own URL from the request — so this is a provisioning input in the
# same sense the key is, and the first env to name the gateway's public host.
#
# Unset, the script skips the webhook block and says so; the endpoint then has
# to be created by hand or by `stripe listen`, which is the state known-gaps #25
# is about. The restricted key needs `Webhook Endpoints` READ AND WRITE for this
# block — read is used even on a dry run, which lists before it decides.
STRIPE_WEBHOOK_URL = https://api.example.test/api/v1/webhooks/stripe
